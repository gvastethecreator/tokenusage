{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 Restore",
      "type": "shell",
      "command": "dotnet restore src/TokenUsage.App/TokenUsage.App.csproj",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🔎 Deps",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./scripts/deps-check.ps1",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🛡️ Audit",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./scripts/audit.ps1",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🚀 Run",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./BuildAndRun.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🔨 Build",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./BuildAndRun.ps1 -SkipRun",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🧪 Test",
      "type": "shell",
      "command": "dotnet test TokenUsage.slnx -p:Platform=x64",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "✅ Check",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./scripts/check.ps1",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "🧹 Clean",
      "type": "shell",
      "command": "dotnet clean TokenUsage.slnx",
      "problemMatcher": "$msCompile"
    }
  ]
}
