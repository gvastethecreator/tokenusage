<Project>
  <PropertyGroup>
    <Product>TokenUsage</Product>
    <Description>Windows quota, token usage, and spend tracking for AI coding tools.</Description>
    <Authors>TokenUsage contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gvastethecreator/wopenusage</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="ValidateConcretePlatform" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'">
    <Error Text="WOpenUsage requires Platform=x64 or Platform=ARM64; received '$(Platform)'." />
  </Target>
</Project>
