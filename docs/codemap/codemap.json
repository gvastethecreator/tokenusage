    {
      "trigger": "The report window loads or changes provider scope",
      "steps": [
        "src-tokenusage-app",
        "src-tokenusage-core"
      ],
      "outcome": "One durable report read is projected globally or filtered by provider in memory."
    },
    {
      "trigger": "A CLI usage, limits, doctor, or report command runs",
