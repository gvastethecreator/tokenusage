        "src-tokenusage-cli",
        "src-tokenusage-runtime-windows",
        "src-tokenusage-providers",
        "src-tokenusage-core"
      ],
      "outcome": "The CLI uses the same provider composition and Core stores while preserving its stable JSON contract."
    },
    {
