      "steps": [
        "src-tokenusage-app",
        "src-tokenusage-runtime-windows",
        "src-tokenusage-providers",
        "src-tokenusage-core"
      ],
      "outcome": "Windows composition invokes read-only provider adapters and Core normalizes their usage events."
