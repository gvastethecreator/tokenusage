<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WOpenUsage.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WOpenUsage.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DashboardCardCornerRadius">12</CornerRadius>

            <!-- WOpenUsage data-visualization colors; these are not provider brand colors. -->
            <Color x:Key="ProviderAntigravityColorDark">#FF2458AA</Color>
            <Color x:Key="ProviderAntigravityColor">#FF4285F4</Color>
            <Color x:Key="ProviderClaudeColorDark">#FFA04732</Color>
            <Color x:Key="ProviderClaudeColor">#FFDE7356</Color>
            <Color x:Key="ProviderCodexColorDark">#FF086B54</Color>
            <Color x:Key="ProviderCodexColor">#FF10A37F</Color>
            <Color x:Key="ProviderGrokColorDark">#FF4C36B8</Color>
            <Color x:Key="ProviderGrokColor">#FF7C5CFC</Color>
            <Color x:Key="ProviderOpenCodeColorDark">#FF9F2F62</Color>
            <Color x:Key="ProviderOpenCodeColor">#FFE5488C</Color>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="QuotaHealthyBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <StaticResource x:Key="QuotaCautionBrush" ResourceKey="SystemFillColorCautionBrush" />
                    <SolidColorBrush x:Key="QuotaWarningBrush" Color="#FFF7630C" />
                    <StaticResource x:Key="QuotaCriticalBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <LinearGradientBrush x:Key="ProviderAntigravityBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderAntigravityColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderAntigravityColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderClaudeBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderClaudeColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderClaudeColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderCodexBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderCodexColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderCodexColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderGrokBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderGrokColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderGrokColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderOpenCodeBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderOpenCodeColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderOpenCodeColor}" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ProviderDonutShadowBrush" Color="#24000000" />
                    <x:Double x:Key="ProviderDonutShadowOpacity">1</x:Double>
                    <Visibility x:Key="ProviderBrandMarkVisibility">Visible</Visibility>
                    <Visibility x:Key="ProviderHighContrastMarkVisibility">Collapsed</Visibility>
                    <StaticResource x:Key="ProviderFallbackBrush" ResourceKey="TextFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="QuotaHealthyBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <StaticResource x:Key="QuotaCautionBrush" ResourceKey="SystemFillColorCautionBrush" />
                    <SolidColorBrush x:Key="QuotaWarningBrush" Color="#FFFF8C42" />
                    <StaticResource x:Key="QuotaCriticalBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <LinearGradientBrush x:Key="ProviderAntigravityBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderAntigravityColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderAntigravityColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderClaudeBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderClaudeColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderClaudeColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderCodexBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderCodexColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderCodexColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderGrokBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderGrokColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderGrokColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ProviderOpenCodeBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ProviderOpenCodeColorDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ProviderOpenCodeColor}" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ProviderDonutShadowBrush" Color="#30000000" />
                    <x:Double x:Key="ProviderDonutShadowOpacity">1</x:Double>
                    <Visibility x:Key="ProviderBrandMarkVisibility">Visible</Visibility>
                    <Visibility x:Key="ProviderHighContrastMarkVisibility">Collapsed</Visibility>
                    <StaticResource x:Key="ProviderFallbackBrush" ResourceKey="TextFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="QuotaHealthyBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="QuotaCautionBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="QuotaWarningBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="QuotaCriticalBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ProviderAntigravityBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ProviderClaudeBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ProviderCodexBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ProviderGrokBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ProviderOpenCodeBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ProviderDonutShadowBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <x:Double x:Key="ProviderDonutShadowOpacity">0</x:Double>
                    <Visibility x:Key="ProviderBrandMarkVisibility">Collapsed</Visibility>
                    <Visibility x:Key="ProviderHighContrastMarkVisibility">Visible</Visibility>
                    <StaticResource x:Key="ProviderFallbackBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
