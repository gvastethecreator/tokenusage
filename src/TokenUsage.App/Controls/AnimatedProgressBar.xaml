<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Controls.AnimatedProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">
    <Grid>
        <Grid IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="HealthyBrushProxy" Background="{ThemeResource QuotaHealthyBrush}" />
            <Border x:Name="CautionBrushProxy" Background="{ThemeResource QuotaCautionBrush}" />
            <Border x:Name="WarningBrushProxy" Background="{ThemeResource QuotaWarningBrush}" />
            <Border x:Name="CriticalBrushProxy" Background="{ThemeResource QuotaCriticalBrush}" />
        </Grid>
        <ProgressBar
            x:Name="FillBar"
            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
            Maximum="100"
            RenderTransformOrigin="0.5,0.5"
            Value="0">
            <ProgressBar.RenderTransform>
                <ScaleTransform ScaleY="{x:Bind IndicatorScale, Mode=OneWay}" />
            </ProgressBar.RenderTransform>
        </ProgressBar>
    </Grid>
</UserControl>
