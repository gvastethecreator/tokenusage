<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="TokenUsage.App.Controls.CodexAccountQuotaList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:viewModels="using:TokenUsage.App.ViewModels"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard">
    <ItemsControl x:Name="AccountItems" HorizontalContentAlignment="Stretch">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewModels:CodexAccountQuota">
                <ContentControl Margin="0,4,0,14" Padding="0"
                        HorizontalContentAlignment="Stretch" IsTabStop="True" UseSystemFocusVisuals="True"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind AutomationName}"
                        ToolTipService.ToolTip="{x:Bind AutomationName}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind HasNoWindows}">
                            <controls:ProviderMarkImage ProviderId="codex" Width="15" Height="15" />
                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Windows}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dashboard:QuotaWindow">
                                    <StackPanel Spacing="7" Margin="0,0,0,2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <controls:ProviderMarkImage ProviderId="{x:Bind ProviderId}" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ProfileLabel}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CompactRemainingText}" FontSize="13" />
                                        </Grid>
                                        <controls:AnimatedProgressBar Height="6" IndicatorScale="1.5"
                                            RemainingValue="{x:Bind ColorRemainingPercent}" TargetValue="{x:Bind RemainingPercent}"
                                            AutomationProperties.AutomationId="{x:Bind PaceAutomationId}"
                                            AutomationName="{x:Bind AutomationName}" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind WindowDetailText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ResetText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind StatusDetail}" Visibility="{x:Bind NeedsAttention}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ContentControl>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
