<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Controls.UsageHeatmap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Content"
    AutomationProperties.Name="{x:Bind Data.AccessibleName, Mode=OneWay}"
    IsTabStop="False">
    <Grid>
        <Grid IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="ActiveBrushProxy" Background="{ThemeResource TextFillColorPrimaryBrush}" />
            <Border x:Name="EmptyBrushProxy" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="StrokeBrushProxy" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <Border x:Name="SecondaryTextBrushProxy" Background="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="ActiveTextBrushProxy" Background="{ThemeResource TokenUsageShellBrush}" />
            <Border x:Name="EmptyTextBrushProxy" Background="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>
        <Grid
            x:Name="CellGrid"
            AutomationProperties.AccessibilityView="Raw"
            HorizontalAlignment="Center" />
    </Grid>
</UserControl>
