<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Controls.UsageTrendChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyDown="OnKeyDown">
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="PlotRegion" Height="{x:Bind PlotHeight, Mode=OneWay}">
            <Canvas
                x:Name="YAxisCanvas"
                Width="54"
                HorizontalAlignment="Left"
                IsHitTestVisible="False" />
            <Canvas
                x:Name="PlotCanvas"
                Margin="62,0,0,0"
                Background="Transparent"
                PointerExited="OnPointerExited"
                PointerMoved="OnPointerMoved"
                SizeChanged="OnPlotSizeChanged" />

            <TextBlock
                x:Name="EmptyText"
                x:Uid="UsageTrendEmpty"
                Margin="62,0,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />

            <Border
                x:Name="HoverCard"
                Width="220"
                Padding="10,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
                BorderThickness="2"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HoverTransform" />
                </Border.RenderTransform>
                <StackPanel x:Name="HoverContent" Spacing="5" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="62,0,0,0">
            <TextBlock
                x:Name="FirstDayLabel"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Name="MiddleDayLabel"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Name="LastDayLabel"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Right"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Border
            x:Name="GridBrushProxy"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="Collapsed" />
        <Border
            x:Name="TextBrushProxy"
            Background="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed" />
        <Border
            x:Name="SurfaceBrushProxy"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
