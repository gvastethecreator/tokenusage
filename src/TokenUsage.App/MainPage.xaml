<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TokenUsage.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:converters="using:TokenUsage.App.Converters"
    xmlns:sample="using:TokenUsage.App.ViewModels.Sample"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:TokenUsage.App.ViewModels"
    xmlns:optionViews="using:TokenUsage.App.Views.Options"
    xmlns:dashboardViews="using:TokenUsage.App.Views.Dashboard"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid x:Name="CaptureSurface">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AppearanceDensityStates">
                <VisualState x:Name="RegularDensity">
                    <VisualState.Setters>
                        <Setter Target="FlyoutChrome.Padding" Value="14" />
                        <Setter Target="RootLayout.RowSpacing" Value="10" />
                        <Setter Target="EmptyStateStack.Spacing" Value="12" />
                        <Setter Target="UnavailableStateStack.Spacing" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactDensity">
                    <VisualState.Setters>
                        <Setter Target="FlyoutChrome.Padding" Value="12" />
                        <Setter Target="RootLayout.RowSpacing" Value="8" />
                        <Setter Target="EmptyStateStack.Spacing" Value="8" />
                        <Setter Target="UnavailableStateStack.Spacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border
            x:Name="OpaqueSurface"
            Background="{ThemeResource TokenUsageShellBrush}"
            CornerRadius="12"
            IsHitTestVisible="False" />
        <Border
            x:Name="FlyoutChrome"
            SizeChanged="OnFlyoutChromeSizeChanged"
            Padding="14"
            Background="{ThemeResource TokenUsageShellBrush}"
            BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
            BorderThickness="2"
            CornerRadius="12">
        <Grid x:Name="RootLayout" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsUsageSurface, Mode=OneWay}">
                    <Image
                        Height="32"
                        Source="{ThemeResource TokenUsageAppIconSource}"
                        Width="32" />
                    <TextBlock
                        x:Uid="ProviderHeader"
                        FontSize="17"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <Border
                        Padding="7,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsSampleContext, Mode=OneWay}">
                        <TextBlock
                            x:Uid="SampleBadge"
                            AutomationProperties.AutomationId="SampleBadge"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>

                <TextBlock
                    x:Uid="OptionsHeader"
                    Grid.Column="0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}" />

                <StackPanel
                    x:Name="HeaderActionButtons"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsUsageSurface, Mode=OneWay}">

                    <Button
                        x:Name="HeaderShareButton"
                        x:Uid="HeaderShareButton"
                        AutomationProperties.AutomationId="HeaderShareButton"
                        Background="{ThemeResource TokenUsageButtonBrush}"
                        Click="OnShareCaptureClick"
                        Foreground="{ThemeResource TokenUsageButtonForegroundBrush}"
                        Padding="8">
                        <controls:TablerIcon Kind="share" />
                    </Button>
                    <Button
                        x:Name="UsageReportButton"
                        x:Uid="UsageReportButton"
                        AutomationProperties.AutomationId="UsageReportButton"
                        Click="OnUsageReportButtonClick"
                        Background="{ThemeResource TokenUsageButtonBrush}"
                        Foreground="{ThemeResource TokenUsageButtonForegroundBrush}"
                        Padding="8">
                        <controls:TablerIcon Kind="file-analytics" />
                    </Button>
                    <Button
                        x:Name="HeaderVisualizationButton"
                        AutomationProperties.AutomationId="HeaderVisualizationButton"
                        AutomationProperties.Name="{x:Bind ViewModel.Dashboard.VisualizationToggleText, Mode=OneWay}"
                        Background="{ThemeResource TokenUsageButtonBrush}"
                        Click="OnVisualizationToggleClick"
                        Foreground="{ThemeResource TokenUsageButtonForegroundBrush}"
                        Padding="8"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Dashboard.VisualizationToggleText, Mode=OneWay}">
                        <controls:TablerIcon Kind="{x:Bind ViewModel.Dashboard.VisualizationToggleIcon, Mode=OneWay}" />
                    </Button>
                    <Button
                        x:Name="HeaderRefreshButton"
                        x:Uid="HeaderRefreshButton"
                        AutomationProperties.AutomationId="HeaderRefreshButton"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Background="{ThemeResource TokenUsageButtonBrush}"
                        Foreground="{ThemeResource TokenUsageButtonForegroundBrush}"
                        Padding="8">
                        <controls:TablerIcon Kind="refresh" />
                    </Button>
                    <Button
                        x:Name="HeaderOptionsButton"
                        x:Uid="HeaderOptionsButton"
                        AutomationProperties.AutomationId="HeaderOptionsButton"
                        Command="{x:Bind ViewModel.OpenOptionsCommand}"
                        Background="{ThemeResource TokenUsageButtonBrush}"
                        Foreground="{ThemeResource TokenUsageButtonForegroundBrush}"
                        Padding="8">
                        <controls:TablerIcon Kind="settings" />
                    </Button>
                </StackPanel>

                <Button
                    x:Name="OptionsBackButton"
                    x:Uid="OptionsBackButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="OptionsBackButton"
                    Command="{x:Bind ViewModel.OptionsNavigation.NavigateBackCommand}"
                    Padding="8"
                    Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        IsTextScaleFactorEnabled="False"
                        Glyph="&#xE72B;" />
                </Button>
            </Grid>

            <ScrollViewer
                x:Name="BodyScrollViewer"
                Grid.Row="1"
                AutomationProperties.AutomationId="BodyScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <ScrollViewer.RenderTransform>
                    <CompositeTransform x:Name="BodyTransitionTransform" />
                </ScrollViewer.RenderTransform>
                <Grid
                    x:Name="CompactCaptureRoot"
                    MinHeight="112"
                    Background="{ThemeResource TokenUsageShellBrush}">
                    <Border
                        MinHeight="112"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
                        BorderThickness="2"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsCardSurface, Mode=OneWay}">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                                <ProgressRing
                                    x:Name="LoadingProgressRing"
                                    x:Uid="LoadingProgressRing"
                                    AutomationProperties.AutomationId="LoadingProgressRing"
                                    Height="36"
                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    Width="36" />
                                <TextBlock
                                    x:Uid="LoadingLabel"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="{x:Bind ViewModel.IsLiveLoading, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="SampleLoadingLabel"
                                    AutomationProperties.AutomationId="SampleLoadingLabel"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="{x:Bind ViewModel.IsSampleLoading, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="EmptyStateStack"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                                <TextBlock
                                    x:Uid="EmptyTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="EmptyBody"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    x:Name="EmptyOpenOptionsButton"
                                    x:Uid="EmptyOpenOptionsButton"
                                    AutomationProperties.AutomationId="EmptyOpenOptionsButton"
                                    Command="{x:Bind ViewModel.OpenOptionsCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="UnavailableStateStack"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsSampleUnavailable, Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UnavailableTitle, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UnavailableBody, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    x:Name="SampleRetryButton"
                                    AutomationProperties.AutomationId="SampleRetryButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.RetryAutomationName, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    Content="{x:Bind ViewModel.RetryButtonText, Mode=OneWay}"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <optionViews:OptionsView
                                x:Name="OptionsSurfaceView"
                                ViewModel="{x:Bind ViewModel.Options, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <dashboardViews:CompactUsageDashboard
                        x:Name="DashboardSurfaceView"
                        LayoutAnimationProgressed="OnDashboardLayoutAnimationProgressed"
                        OptionsRequested="OnDashboardOptionsRequested"
                        ReportRequested="OnDashboardReportRequested"
                        ViewModel="{x:Bind ViewModel.Dashboard, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsSample, Mode=OneWay}" />
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FooterIdentityColumn" Width="0" />
                    <ColumnDefinition x:Name="FooterStatusColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="FlyoutFooterIdentity"
                    x:Uid="FlyoutFooterIdentity"
                    Grid.Column="0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxWidth="120"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="FlyoutStatusText"
                    AutomationProperties.AutomationId="FlyoutStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="FooterOptionsButton"
                    x:Uid="FooterOptionsButton"
                    AutomationProperties.AutomationId="FooterOptionsButton"
                    Command="{x:Bind ViewModel.OpenOptionsCommand}"
                    Visibility="Collapsed" />

            </Grid>
        </Grid>
        </Border>
        <InfoBar
            x:Name="ShareStatusInfoBar"
            AutomationProperties.AutomationId="ShareStatusInfoBar"
            AutomationProperties.LiveSetting="Polite"
            Margin="12"
            MaxWidth="430"
            HorizontalAlignment="Center"
            IsClosable="True"
            IsOpen="False"
            VerticalAlignment="Top" />
    </Grid>
</Page>
