<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Dashboard.CompactUsageDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard">

    <UserControl.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="45" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CompactCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TokenUsageCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource TokenUsageStrokeBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <DataTemplate x:Key="CompactQuotaWindowTileTemplate" x:DataType="dashboard:QuotaWindow">
            <Grid Padding="0,5,0,6" RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        FontFamily="Consolas"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind RemainingText}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </Grid>
                <controls:AnimatedProgressBar
                    Grid.Row="1"
                    Height="6"
                    AutomationName="{x:Bind DisplayAutomationName}"
                    RemainingValue="{x:Bind ColorRemainingPercent}"
                    TargetValue="{x:Bind RemainingPercent}" />
                <TextBlock
                    Grid.Row="2"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ResetText}"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis">
                    <ToolTipService.ToolTip>
                        <ToolTip
                            MaxWidth="332"
                            Content="{x:Bind ResetText}"
                            ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ScopeTransitionRoot">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="ScopeTransitionTransform" />
        </Grid.RenderTransform>
        <StackPanel
            x:Name="RootStack"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsGlobalScope, Mode=OneWay}">

            <Border BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" />

            <StackPanel Spacing="3">
                <TextBlock
                    AutomationProperties.AutomationId="CompactGlobalCost"
                    FontFamily="Consolas"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.GlobalCostText, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock
                        x:Uid="CompactGlobalSummaryLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button
                        AutomationProperties.AutomationId="CompactCoverageHint"
                        AutomationProperties.Name="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                        MinHeight="22"
                        MinWidth="22"
                        Padding="3"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasCoverageHint, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            <ToolTip
                                MaxWidth="332"
                                Content="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                                ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}"
                                Placement="Bottom" />
                        </ToolTipService.ToolTip>
                        <FontIcon FontSize="12" Glyph="&#xE946;" IsTextScaleFactorEnabled="False" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <ItemsRepeater Height="5" ItemsSource="{x:Bind ViewModel.ProviderSummaries, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="0" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="dashboard:DashboardProviderSummary">
                        <controls:ProviderColorSwatch
                            ColorHex="{x:Bind ColorHex}"
                            Height="5"
                            ProviderId="{x:Bind ProviderId}"
                            Width="{x:Bind CompositionWidth}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ItemsRepeater
                AutomationProperties.AutomationId="CompactProviderList"
                ItemsSource="{x:Bind ViewModel.ProviderSummaries, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsListVisualization, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="dashboard:DashboardProviderSummary">
                        <Border BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,0,0,1">
                            <Button
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="2,10"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind ProviderId}"
                                Click="OnProviderClick">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ProviderMarkImage Height="18" ProviderId="{x:Bind ProviderId}" Width="18" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{x:Bind CostText}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DetailText}" TextAlignment="Right" />
                                    <FontIcon Grid.Column="4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid
                Height="188"
                ColumnSpacing="18"
                Visibility="{x:Bind ViewModel.IsDonutVisualization, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="186" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:SpendDonutChart
                    AccessibleName="{x:Bind ViewModel.GlobalCostText, Mode=OneWay}"
                    AutomationProperties.AutomationId="CompactSpendDonut"
                    CenterFontSize="15"
                    CenterMaxWidth="96"
                    CenterValue="{x:Bind ViewModel.GlobalDonutCenterText, Mode=OneWay}"
                    Height="180"
                    ProviderInvoked="OnDonutProviderInvoked"
                    Slices="{x:Bind ViewModel.GlobalSpendSlices, Mode=OneWay}"
                    Width="180" />
                <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.ProviderSummaries, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:DashboardProviderSummary">
                            <Button
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                HorizontalContentAlignment="Stretch"
                                Padding="3,9"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind ProviderId}"
                                Click="OnProviderClick">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ProviderMarkImage Height="16" ProviderId="{x:Bind ProviderId}" Width="16" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DetailText}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>

            <StackPanel Spacing="7" Visibility="{x:Bind ViewModel.IsHeatmapVisualization, Mode=OneWay}">
                <Grid>
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.GlobalHeatmap.Title, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.GlobalHeatmap.DateRangeText, Mode=OneWay}" />
                </Grid>
                <Grid Margin="2,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="CompactWeekdayMonday" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="CompactWeekdayTuesday" Grid.Column="1" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="CompactWeekdayWednesday" Grid.Column="2" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="CompactWeekdayThursday" Grid.Column="3" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="CompactWeekdayFriday" Grid.Column="4" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="CompactWeekdaySaturday" Grid.Column="5" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="CompactWeekdaySunday" Grid.Column="6" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <controls:UsageHeatmap
                    AutomationProperties.AutomationId="CompactUsageHeatmap"
                    CellHeight="38"
                    CellWidth="62"
                    Data="{x:Bind ViewModel.GlobalHeatmap, Mode=OneWay}"
                    DayInvoked="OnHeatmapDayInvoked"
                    ShowDayLabels="True" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="CompactHeatmapLegendLow" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid Grid.Column="1" ColumnSpacing="3" AutomationProperties.AccessibilityView="Raw">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="4" Background="{ThemeResource TextFillColorPrimaryBrush}" CornerRadius="2" Opacity="0.475" />
                        <Border Grid.Column="1" Height="4" Background="{ThemeResource TextFillColorPrimaryBrush}" CornerRadius="2" Opacity="0.65" />
                        <Border Grid.Column="2" Height="4" Background="{ThemeResource TextFillColorPrimaryBrush}" CornerRadius="2" Opacity="0.825" />
                        <Border Grid.Column="3" Height="4" Background="{ThemeResource TextFillColorPrimaryBrush}" CornerRadius="2" />
                    </Grid>
                    <TextBlock x:Uid="CompactHeatmapLegendHigh" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <Border
                Padding="12,9"
                Style="{StaticResource CompactCardStyle}"
                Visibility="{x:Bind ViewModel.HasGlobalCodexLimits, Mode=OneWay}">
                <StackPanel Spacing="5">
                    <TextBlock x:Uid="CompactGlobalLimitsTitle" Style="{StaticResource SectionLabelStyle}" />
                    <ItemsRepeater
                        ItemTemplate="{StaticResource CompactQuotaWindowTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.GlobalCodexLimits, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <StackPanel Spacing="5" Visibility="{x:Bind ViewModel.IsActivitySummaryVisible, Mode=OneWay}">
                <Border Style="{StaticResource CompactCardStyle}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.GlobalActivity, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="140" Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardActivitySummary">
                                <StackPanel Padding="10,7" HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                    <TextBlock HorizontalAlignment="Center" FontFamily="Consolas" FontSize="17" Text="{x:Bind Value}" />
                                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

        </StackPanel>

        <StackPanel
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsProviderScope, Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MaximumRowsOrColumns="4"
                        MinColumnSpacing="2"
                        MinItemWidth="110"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="dashboard:DashboardProviderOption">
                        <ToggleButton
                            AutomationProperties.AutomationId="{x:Bind ProviderId}"
                            AutomationProperties.Name="{x:Bind Name}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsChecked="{x:Bind IsSelected}"
                            Padding="4,10"
                            Tag="{x:Bind ProviderId}"
                            Click="OnProviderClick">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TokenUsageSelectedBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TokenUsageSelectedPointerOverBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TokenUsageSelectedPressedBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TokenUsageSelectedForegroundBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TokenUsageSelectedForegroundBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TokenUsageSelectedForegroundBrush" />
                            </ToggleButton.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <controls:ProviderMarkImage Height="17" ProviderId="{x:Bind ProviderId}" Width="17" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel x:Name="ProviderDetailStack" Spacing="12">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="ProviderDetailTransform" />
                </StackPanel.RenderTransform>

            <Border Padding="16,14" Style="{StaticResource CompactCardStyle}">
                <StackPanel Spacing="13">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ProviderMarkImage Height="22" ProviderId="{x:Bind ViewModel.SelectedProvider.ProviderId, Mode=OneWay}" Width="22" />
                        <TextBlock Grid.Column="1" FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedProviderName, Mode=OneWay}" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.AutomationId="CompactProviderCoverageHint"
                            AutomationProperties.Name="{x:Bind ViewModel.SelectedProviderCoverageHintText, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind ViewModel.SelectedProviderCoverageHintText, Mode=OneWay}"
                            MinHeight="28"
                            MinWidth="28"
                            Padding="6"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="{x:Bind ViewModel.SelectedProviderHasCoverageHint, Mode=OneWay}">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="320" Placement="Bottom">
                                    <TextBlock MaxWidth="288" Text="{x:Bind ViewModel.SelectedProviderCoverageHintText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.SelectedProviderCoverageGlyph, Mode=OneWay}" />
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.SelectedProviderCostText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CompactPeriodText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.SelectedProviderTokensText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CompactPeriodText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ProviderTrendTitle" x:Uid="CompactProviderTrendTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <controls:UsageTrendChart
                            AutomationProperties.AutomationId="CompactProviderTrend"
                            AutomationProperties.LabeledBy="{Binding ElementName=ProviderTrendTitle}"
                            Data="{x:Bind ViewModel.SelectedProviderTrend, Mode=OneWay}"
                            PlotHeight="120" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="12,9" Style="{StaticResource CompactCardStyle}" Visibility="{x:Bind ViewModel.SelectedProviderHasLimits, Mode=OneWay}">
                <StackPanel Spacing="5">
                    <TextBlock x:Uid="CompactProviderCardLimitsTitle" Style="{StaticResource SectionLabelStyle}" />
                    <ItemsRepeater
                        ItemTemplate="{StaticResource CompactQuotaWindowTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.SelectedProviderLimits, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
            </StackPanel>

            <Button
                AutomationProperties.AutomationId="CompactGlobalBackButton"
                AutomationProperties.Name="{x:Bind ViewModel.GlobalFooterText, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="0,3,0,0"
                Padding="12,9"
                Click="OnGlobalClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.GlobalFooterText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
