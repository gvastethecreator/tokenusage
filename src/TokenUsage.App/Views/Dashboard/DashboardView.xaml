<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Dashboard.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="DashboardAmountTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DashboardHeadingTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DashboardCompactStrongTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DashboardCaptionTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <DataTemplate x:Key="DashboardPrimaryMetricTemplate" x:DataType="dashboard:DashboardMetric">
            <Border
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                MinHeight="68"
                Padding="10,8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="3">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                        Text="{x:Bind Label, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="18"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Value, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DashboardSecondaryMetricTemplate" x:DataType="dashboard:DashboardMetric">
            <Border
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                MinHeight="52"
                Padding="9,7"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                        Text="{x:Bind Label, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                        Text="{x:Bind Value, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel
        x:Name="DashboardStack"
        Spacing="10">
        <Grid Margin="4,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Style="{StaticResource DashboardHeadingTextBlockStyle}"
                    Text="{x:Bind ViewModel.Heading, Mode=OneWay}" />
                <Grid>
                    <TextBlock
                        AutomationProperties.AutomationId="CodexDataState"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.LiveDataStateText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLiveDataStateVisible, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="{x:Bind ViewModel.SampleDataStateAutomationId, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SampleDataStateText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsSampleDataStateVisible, Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <ProgressRing
                    x:Name="SampleRefreshProgressRing"
                    x:Uid="LoadingProgressRing"
                    AutomationProperties.AutomationId="SampleRefreshProgressRing"
                    Height="14"
                IsActive="{x:Bind ViewModel.IsSessionRefreshing, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSessionRefreshing, Mode=OneWay}"
                    Width="14" />
                <TextBlock
                    Style="{StaticResource DashboardAmountTextBlockStyle}"
                    Text="{x:Bind ViewModel.ActiveSample.TotalSpendAmount, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ActiveSample.HasSpend, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    
        <Border
            x:Name="SampleTotalSpendCard"
            x:Load="{x:Bind ViewModel.ActiveSample.HasSpend, Mode=OneWay}"
            AutomationProperties.AutomationId="SampleTotalSpendCard"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource DashboardCardCornerRadius}">
            <Grid
                ColumnSpacing="12"
                Loaded="OnSampleSpendLayoutLoaded"
                SizeChanged="OnSampleSpendLayoutSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
    
                <controls:SpendDonutChart
                    x:Name="SampleSpendDonutChart"
                    AccessibleName="{x:Bind ViewModel.ActiveSample.SpendAccessibleName, Mode=OneWay}"
                    AutomationProperties.AutomationId="SampleSpendDonut"
                    CenterValue="{x:Bind ViewModel.ActiveSample.DonutCenterAmount, Mode=OneWay}"
                    Slices="{x:Bind ViewModel.ActiveSample.SpendSlices, Mode=OneWay}" />
    
                <ItemsControl
                    Grid.Column="1"
                    ItemsSource="{x:Bind ViewModel.ActiveSample.SpendSlices, Mode=OneWay}"
                    VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:SpendSlice">
                            <Grid MinHeight="20" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:ProviderColorSwatch
                                    ColorHex="{x:Bind ColorHex}"
                                    Height="12"
                                    ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                    VerticalAlignment="Center"
                                    Width="12" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                    Text="{x:Bind ProviderName}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                    Text="{x:Bind LegendAmountText}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    
        <Border
            x:Name="UsageProductCard"
            AutomationProperties.AutomationId="UsageProductCard"
            AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.Title, Mode=OneWay}"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource DashboardCardCornerRadius}"
            Visibility="{x:Bind ViewModel.IsLocalUsageVisible, Mode=OneWay}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Style="{StaticResource DashboardHeadingTextBlockStyle}"
                        Text="{x:Bind ViewModel.LocalUsage.Title, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <Border
                        Grid.Column="1"
                        Padding="7,3"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.AutomationId="UsageProductCard.Period"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.LocalUsage.PeriodLabel, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="UsageProductCard.AttentionNotice"
                        AutomationProperties.HelpText="{x:Bind ViewModel.LocalUsage.NoticeText, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.NoticeText, Mode=OneWay}"
                        MinHeight="32"
                        MinWidth="32"
                        Padding="6"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LocalUsage.IsNoticeImportant, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            <ToolTip MaxWidth="332" Content="{x:Bind ViewModel.LocalUsage.NoticeText, Mode=OneWay}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                        </ToolTipService.ToolTip>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE7BA;"
                            IsTextScaleFactorEnabled="False" />
                    </Button>
                    <ToggleButton
                        x:Name="LocalUsageDetailsToggle"
                        x:Uid="ProviderSecondaryMetricsToggle"
                        Grid.Column="3"
                        AutomationProperties.AutomationId="UsageProductCard.DetailsToggle"
                        Checked="OnLocalUsageDetailsChecked"
                        IsChecked="False"
                        MinHeight="32"
                        MinWidth="32"
                        Padding="6"
                        Unchecked="OnLocalUsageDetailsUnchecked"
                        VerticalAlignment="Center">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Glyph="&#xE9D2;"
                            IsTextScaleFactorEnabled="False" />
                    </ToggleButton>
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        Margin="0,2,0,0"
                        AutomationProperties.AutomationId="UsageProductCard.DataOrigin"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.LocalUsage.SourceLabel, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
    
                <StackPanel
                    x:Name="UsageProductDetailsPanel"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.LocalUsage.ExpandedNoticeText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
    
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Content="{x:Bind ViewModel.LocalUsage.ReportedCostMetric, Mode=OneWay}"
                            ContentTemplate="{StaticResource DashboardPrimaryMetricTemplate}"
                            HorizontalContentAlignment="Stretch" />
                        <ContentControl
                            Grid.Column="1"
                            Content="{x:Bind ViewModel.LocalUsage.EstimatedCostMetric, Mode=OneWay}"
                            ContentTemplate="{StaticResource DashboardPrimaryMetricTemplate}"
                            HorizontalContentAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            Content="{x:Bind ViewModel.LocalUsage.TotalTokensMetric, Mode=OneWay}"
                            ContentTemplate="{StaticResource DashboardSecondaryMetricTemplate}"
                            HorizontalContentAlignment="Stretch" />
                        <ContentControl
                            Grid.Column="1"
                            Content="{x:Bind ViewModel.LocalUsage.CostCoverageMetric, Mode=OneWay}"
                            ContentTemplate="{StaticResource DashboardSecondaryMetricTemplate}"
                            HorizontalContentAlignment="Stretch" />
                        <ContentControl
                            Grid.Row="1"
                            Content="{x:Bind ViewModel.LocalUsage.UnpricedUsageMetric, Mode=OneWay}"
                            ContentTemplate="{StaticResource DashboardSecondaryMetricTemplate}"
                            HorizontalContentAlignment="Stretch" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="{x:Bind ViewModel.LocalUsage.CostPerMillionMetric, Mode=OneWay}"
                            ContentTemplate="{StaticResource DashboardSecondaryMetricTemplate}"
                            HorizontalContentAlignment="Stretch" />
                    </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.LocalUsage.OtherPeriods, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:LocalUsagePeriodRow">
                            <Border
                                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                MinHeight="44"
                                Margin="0,0,0,4"
                                Padding="10,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid ColumnSpacing="10" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                                        Text="{x:Bind Label, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                                        Text="{x:Bind CostText, Mode=OneTime}"
                                        TextAlignment="Right"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                        Text="{x:Bind DetailText, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                    <Border
                        Padding="10,8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ViewModel.LocalUsage.Heatmap.HasData, Mode=OneWay}">
                        <StackPanel
                            AutomationProperties.AutomationId="UsageProductCard.Heatmap"
                            AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.Heatmap.AccessibleName, Mode=OneWay}"
                            Spacing="6">
                            <Grid
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.LocalUsage.Heatmap.Title, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.LocalUsage.Heatmap.Summary, Mode=OneWay}" />
                            </Grid>
                            <controls:UsageHeatmap Data="{x:Bind ViewModel.LocalUsage.Heatmap, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
    
                <Expander
                    AutomationProperties.AutomationId="UsageProductCard.Breakdown30Days"
                    AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AccessibleName, Mode=OneWay}"
                    Expanding="OnUsageDetailsExpanding"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False"
                    Visibility="{x:Bind ViewModel.LocalUsage.HasUsageDetails, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Spacing="1">
                            <TextBlock
                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.LocalUsage.SpendBreakdown.Title, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.LocalUsage.SpendBreakdown.SummaryText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Padding="0,6,0,0" Spacing="8">
                        <Grid
                            AutomationProperties.AutomationId="UsageProductCard.AgentRing30Days"
                            AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AccessibleName, Mode=OneWay}"
                            ColumnSpacing="10"
                            Loaded="OnSampleSpendLayoutLoaded"
                            SizeChanged="OnSampleSpendLayoutSizeChanged"
                            Visibility="{x:Bind ViewModel.LocalUsage.SpendBreakdown.HasAgentSpend, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:SpendDonutChart
                                AccessibleName="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AccessibleName, Mode=OneWay}"
                                AutomationProperties.AutomationId="UsageProductCard.AgentSpendDonut"
                                CenterValue="{x:Bind ViewModel.LocalUsage.SpendBreakdown.DonutCenterText, Mode=OneWay}"
                                Height="104"
                                Slices="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AgentSlices, Mode=OneWay}"
                                Width="104" />
                            <ItemsControl
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AgentSlices, Mode=OneWay}"
                                VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dashboard:SpendSlice">
                                        <Grid MinHeight="24" ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:ProviderColorSwatch
                                                ColorHex="{x:Bind ColorHex, Mode=OneTime}"
                                                Height="12"
                                                ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                                VerticalAlignment="Center"
                                                Width="12" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                Text="{x:Bind ProviderName, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                Text="{x:Bind LegendAmountText, Mode=OneTime}"
                                                TextAlignment="Right"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
    
                        <ListView
                            AutomationProperties.AutomationId="UsageProductCard.ModelBreakdown"
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.LocalUsage.SpendBreakdown.Models, Mode=OneWay}"
                            MaxHeight="180"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.LocalUsage.SpendBreakdown.HasModels, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dashboard:LocalUsageModelRow">
                                    <Grid
                                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                        MinHeight="44"
                                        Padding="4,5"
                                        ColumnSpacing="12"
                                        RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                            Text="{x:Bind Title, Mode=OneTime}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                            Text="{x:Bind CoverageText, Mode=OneTime}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                            Text="{x:Bind ReportedText, Mode=OneTime}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                            Text="{x:Bind EstimatedText, Mode=OneTime}"
                                            TextAlignment="Right"
                                            TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Border>
    
        <Border
            AutomationProperties.AutomationId="DashboardAllProvidersHidden"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Padding="10,8"
            Visibility="{x:Bind ViewModel.AreAllProvidersHidden, Mode=OneWay}">
            <TextBlock
                x:Uid="DashboardAllProvidersHidden"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                TextWrapping="WrapWholeWords" />
        </Border>
    
        <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveSample.Providers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dashboard:ProviderCard">
                    <StackPanel Margin="0,0,0,10" Spacing="6">
                        <Grid Margin="4,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:ProviderMarkImage
                                Height="18"
                                ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                VerticalAlignment="Center"
                                Width="18" />
                            <Grid Grid.Column="1" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Grid.Column="1"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE734;"
                                    IsTextScaleFactorEnabled="False"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HasHighlight}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip MaxWidth="332" Content="{x:Bind HighlightLabel}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                                    </ToolTipService.ToolTip>
                                </FontIcon>
                            </Grid>
                            <Border
                                Grid.Column="2"
                                Padding="7,2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                    Text="{x:Bind PlanLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button
                                Grid.Column="4"
                                AutomationProperties.AutomationId="{x:Bind DetailsAutomationId}"
                                AutomationProperties.HelpText="{x:Bind DetailsTooltip}"
                                AutomationProperties.Name="{x:Bind DetailsAutomationName}"
                                MinHeight="32"
                                MinWidth="32"
                                Padding="6"
                                Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind HasDetails}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="332" Content="{x:Bind DetailsTooltip}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                                </ToolTipService.ToolTip>
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="14"
                                    IsTextScaleFactorEnabled="False"
                                    Glyph="&#xE946;" />
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Spacing="8" Width="220">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind SourceLabel}" />
                                                <TextBlock
                                                    AutomationProperties.AutomationId="{x:Bind DetailsSourceAutomationId}"
                                                    Text="{x:Bind SourceValue}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ObservedLabel}" />
                                                <TextBlock
                                                    AutomationProperties.AutomationId="{x:Bind DetailsObservedAutomationId}"
                                                    Text="{x:Bind ObservedValue}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <ToggleButton
                                x:Uid="ProviderSecondaryMetricsToggle"
                                Grid.Column="3"
                                AutomationProperties.AutomationId="{x:Bind SecondaryMetricsAutomationId}"
                                Checked="OnProviderUsageDetailsChecked"
                                IsChecked="{x:Bind IsOnDemandMetricsExpanded, Mode=TwoWay}"
                                MinHeight="32"
                                MinWidth="32"
                                Padding="6"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind HasOnDemandMetrics}">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="14"
                                    Glyph="&#xE9D2;"
                                    IsTextScaleFactorEnabled="False" />
                            </ToggleButton>
                        </Grid>
    
                        <Border
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind CardAutomationName}"
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource DashboardCardCornerRadius}">
                            <StackPanel Spacing="7">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                        Text="{x:Bind CapabilityLabel}"
                                        TextWrapping="WrapWholeWords"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="{x:Bind NoticeAutomationId}"
                                        AutomationProperties.HelpText="{x:Bind NoticeText}"
                                        AutomationProperties.Name="{x:Bind NoticeText}"
                                        MinHeight="28"
                                        MinWidth="28"
                                        Padding="5"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind HasNotice}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip MaxWidth="332" Content="{x:Bind NoticeText}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                                        </ToolTipService.ToolTip>
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="13"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            IsTextScaleFactorEnabled="False" />
                                    </Button>
                                </Grid>
    
                                <ItemsControl ItemsSource="{x:Bind PrimaryMetricItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dashboard:DashboardMetricItem">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,10" Spacing="3" Visibility="{x:Bind IsQuotaWindow}">
                                                    <TextBlock Style="{StaticResource DashboardCompactStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                    <controls:AnimatedProgressBar
                                                        AutomationName="{x:Bind WindowAutomationName}"
                                                        Height="5"
                                                        RemainingValue="{x:Bind ColorRemainingPercent}"
                                                        TargetValue="{x:Bind RemainingPercent}" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind RemainingText}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind ResetText}" TextAlignment="Right" TextWrapping="WrapWholeWords" />
                                                    </Grid>
                                                </StackPanel>
                                                <Grid
                                                    AutomationProperties.AutomationId="{x:Bind MetricAutomationId}"
                                                    AutomationProperties.Name="{x:Bind MetricAutomationName}"
                                                    Margin="0,0,0,4"
                                                    ColumnSpacing="8"
                                                    Visibility="{x:Bind IsScalarMetric}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind Value}" TextWrapping="WrapWholeWords" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
    
                                <ItemsControl
                                    ItemsSource="{x:Bind OnDemandMetricItems}"
                                    Visibility="{x:Bind IsOnDemandMetricsExpanded, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dashboard:DashboardMetricItem">
                                                <StackPanel>
                                                <StackPanel Margin="0,0,0,10" Spacing="3" Visibility="{x:Bind IsQuotaWindow}">
                                                    <TextBlock Style="{StaticResource DashboardCompactStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                    <controls:AnimatedProgressBar
                                                        AutomationName="{x:Bind WindowAutomationName}"
                                                        Height="5"
                                                        RemainingValue="{x:Bind ColorRemainingPercent}"
                                                        TargetValue="{x:Bind RemainingPercent}" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                            Text="{x:Bind RemainingText}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                            Text="{x:Bind ResetText}"
                                                            TextAlignment="Right"
                                                            TextWrapping="WrapWholeWords" />
                                                    </Grid>
                                                </StackPanel>
                                                <Grid
                                                    AutomationProperties.AutomationId="{x:Bind MetricAutomationId}"
                                                    AutomationProperties.Name="{x:Bind MetricAutomationName}"
                                                    Margin="0,0,0,4"
                                                    ColumnSpacing="8"
                                                    Visibility="{x:Bind IsScalarMetric}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                        Text="{x:Bind Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                        Text="{x:Bind Value}"
                                                        TextWrapping="WrapWholeWords" />
                                                </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel
                                    AutomationProperties.AutomationId="{x:Bind Heatmap.AutomationId}"
                                    AutomationProperties.Name="{x:Bind Heatmap.AccessibleName}"
                                    Margin="0,4,0,0"
                                    Spacing="4"
                                    Visibility="{x:Bind IsHeatmapExpanded, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DashboardCompactStrongTextBlockStyle}" Text="{x:Bind Heatmap.Title}" />
                                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind Heatmap.Summary}" />
                                    </Grid>
                                    <controls:UsageHeatmap Data="{x:Bind Heatmap}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
