<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Options.AppearanceOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:options="using:TokenUsage.App.Views.Options">

    <Border
        AutomationProperties.AutomationId="AppearanceSection"
        Style="{StaticResource OptionsCategoryCardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="10" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" Style="{StaticResource OptionsCategoryIconStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <ToolTipService.ToolTip>
                        <ToolTip
                            x:Uid="AppearanceSectionDescription"
                            ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}"
                            MaxWidth="300" />
                    </ToolTipService.ToolTip>
                    <TextBlock x:Uid="AppearanceSectionTitle" Style="{StaticResource OptionsCategoryTitleStyle}" />
                </StackPanel>
            </Grid>
            <ContentControl
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                Padding="0"
                VerticalContentAlignment="Top">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </ControlTemplate>
                </ContentControl.Template>
                <Grid
                x:Name="AppearanceSettingsGrid"
                ColumnSpacing="10"
                RowSpacing="0"
                VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="AppearanceThemeGroup" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock x:Uid="AppearanceThemeLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceThemeSelector"
                            x:Uid="AppearanceThemeSelector"
                            AutomationProperties.AutomationId="AppearanceThemeSelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceDensityGroup" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock x:Uid="AppearanceDensityLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceDensitySelector"
                            x:Uid="AppearanceDensitySelector"
                            AutomationProperties.AutomationId="AppearanceDensitySelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DensityOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedDensity, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceTransparencyGroup" Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock x:Uid="AppearanceTransparencyLabel" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch
                            x:Name="AppearanceTransparencyToggle"
                            x:Uid="AppearanceTransparencyToggle"
                            AutomationProperties.AutomationId="AppearanceTransparencyToggle"
                            HorizontalAlignment="Left"
                            IsOn="{x:Bind ViewModel.IncreaseTransparency, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceUsageGroup" Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock x:Uid="AppearanceUsageLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceUsageSelector"
                            x:Uid="AppearanceUsageSelector"
                            AutomationProperties.AutomationId="AppearanceUsageSelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.UsageDisplayOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedUsageDisplay, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceResetGroup" Grid.Row="4" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock x:Uid="AppearanceResetTimeLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceResetTimeSelector"
                            x:Uid="AppearanceResetTimeSelector"
                            AutomationProperties.AutomationId="AppearanceResetTimeSelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.ResetTimeDisplayOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedResetTimeDisplay, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceVisualizationGroup" Grid.Row="5" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock x:Uid="AppearanceVisualizationLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceVisualizationSelector"
                            x:Uid="AppearanceVisualizationSelector"
                            AutomationProperties.AutomationId="AppearanceVisualizationSelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DashboardVisualizationOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedDashboardVisualization, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid x:Name="AppearanceTrayPopoverGroup" Grid.Row="6" Grid.ColumnSpan="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="AppearanceTrayPopoverHeading"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="AppearanceTrayPopoverEnabledToggle"
                            x:Uid="AppearanceTrayPopoverEnabledToggle"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AppearanceTrayPopoverEnabledToggle"
                            HorizontalAlignment="Right"
                            IsOn="{x:Bind ViewModel.ShowTrayPopover, Mode=TwoWay}"
                            OffContent=""
                            OnContent=""
                            VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel
                        x:Name="AppearanceTrayPrimaryGroup"
                        Grid.Row="7"
                        Spacing="4">
                        <TextBlock x:Uid="AppearanceTrayPrimaryLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceTrayPrimarySelector"
                            x:Uid="AppearanceTrayPrimarySelector"
                            AutomationProperties.AutomationId="AppearanceTrayPrimarySelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.ShowTrayPopover, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.TrayPopoverPrimaryOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedTrayPopoverPrimary, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="AppearanceTraySecondaryGroup"
                        Grid.Row="7"
                        Grid.Column="1"
                        Spacing="4">
                        <TextBlock x:Uid="AppearanceTraySecondaryLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceTraySecondarySelector"
                            x:Uid="AppearanceTraySecondarySelector"
                            AutomationProperties.AutomationId="AppearanceTraySecondarySelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.ShowTrayPopover, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.TrayPopoverSecondaryOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedTrayPopoverSecondary, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="AppearanceTrayCountGroup"
                        Grid.Row="8"
                        Spacing="4">
                        <TextBlock x:Uid="AppearanceTrayProviderCountLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox
                            x:Name="AppearanceTrayProviderCountSelector"
                            x:Uid="AppearanceTrayProviderCountSelector"
                            AutomationProperties.AutomationId="AppearanceTrayProviderCountSelector"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.ShowTrayPopover, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.TrayPopoverProviderCountOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedTrayPopoverProviderCount, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="AppearanceTrayNameGroup"
                        Grid.Row="9"
                        Grid.ColumnSpan="2"
                        Spacing="4">
                        <TextBlock x:Uid="AppearanceTrayProviderNameLabel" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <ToggleSwitch
                            x:Name="AppearanceTrayProviderNameToggle"
                            x:Uid="AppearanceTrayProviderNameToggle"
                            AutomationProperties.AutomationId="AppearanceTrayProviderNameToggle"
                            HorizontalAlignment="Left"
                            IsEnabled="{x:Bind ViewModel.ShowTrayPopover, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.ShowTrayPopoverProviderName, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </StackPanel>

                </Grid>
            </ContentControl>
            <InfoBar
                x:Name="AppearanceStatus"
                AutomationProperties.AutomationId="AppearanceStatus"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}" />
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <options:PersonalizationOptionsView
                x:Name="PersonalizationView"
                ViewModel="{x:Bind PersonalizationViewModel, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
