<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Options.GeneralOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:converters="using:TokenUsage.App.Converters"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:TokenUsage.App.ViewModels"
    mc:Ignorable="d">

    <Border
        AutomationProperties.AutomationId="GeneralSection"
        Style="{StaticResource OptionsCategoryCardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="CloseWhenInactiveLabel"
                    TextWrapping="Wrap"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <ToggleSwitch Style="{StaticResource OptionsInlineToggleStyle}"
                    x:Name="CloseWhenInactiveToggle"
                    x:Uid="CloseWhenInactiveToggle"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="CloseWhenInactiveToggle"
                    HorizontalAlignment="Right"
                    IsOn="{x:Bind ViewModel.CloseWhenInactive, Mode=TwoWay}" MinWidth="0"
                    VerticalAlignment="Center" />
            </Grid>
            <Expander x:Name="CollectionExpander" AutomationProperties.AutomationId="CollectionExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header><TextBlock x:Uid="GeneralCollectionGroupTitle" TextWrapping="Wrap" /></Expander.Header>
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DataCollectionBackgroundLabel" x:Uid="DataCollectionBackgroundLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                            <ToggleSwitch Style="{StaticResource OptionsInlineToggleStyle}" Grid.Column="1" x:Name="DataCollectionBackgroundToggle"
                                x:Uid="DataCollectionBackgroundToggle"
                                AutomationProperties.AutomationId="DataCollectionBackgroundToggle"
                                AutomationProperties.LabeledBy="{Binding ElementName=DataCollectionBackgroundLabel}"
                                IsOn="{x:Bind ViewModel.IsBackgroundCollectionEnabled, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="DataCollectionRefreshLabel" x:Uid="DataCollectionRefreshLabel"
                    TextWrapping="Wrap"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox
                            x:Name="DataCollectionOpenRefreshSelector"
                            AutomationProperties.AutomationId="DataCollectionOpenRefreshSelector"
                    AutomationProperties.LabeledBy="{Binding ElementName=DataCollectionRefreshLabel}"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DataCollectionRefreshOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedDataCollectionRefresh, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander x:Name="ClaudeExpander" AutomationProperties.AutomationId="ClaudeExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header><TextBlock x:Uid="GeneralClaudeGroupTitle" TextWrapping="Wrap" /></Expander.Header>
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClaudeLimitsLabel" x:Uid="ClaudeLimitsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                            <ToggleSwitch Style="{StaticResource OptionsInlineToggleStyle}" Grid.Column="1" x:Name="ClaudeLimitsToggle"
                                x:Uid="ClaudeLimitsToggle"
                                AutomationProperties.AutomationId="ClaudeLimitsToggle"
                                AutomationProperties.LabeledBy="{Binding ElementName=ClaudeLimitsLabel}"
                                IsEnabled="{x:Bind ViewModel.IsClaudeLimitsAvailable, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.IsClaudeLimitsEnabled, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.ClaudeLimitsStatus, Mode=OneWay}"
                            AutomationProperties.AutomationId="ClaudeLimitsStatus"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="ClaudeOpenButton" AutomationProperties.AutomationId="ClaudeOpenButton" Command="{x:Bind ViewModel.OpenClaudeCommand}" />
                            <Button x:Uid="ClaudeRetryButton" AutomationProperties.AutomationId="ClaudeRetryButton" Command="{x:Bind ViewModel.RetryClaudeLimitsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
