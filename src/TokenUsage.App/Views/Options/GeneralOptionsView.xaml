<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Options.GeneralOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:converters="using:TokenUsage.App.Converters"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:TokenUsage.App.ViewModels"
    mc:Ignorable="d">

    <Border
        AutomationProperties.AutomationId="GeneralSection"
        Style="{StaticResource OptionsCategoryCardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="10" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE713;" Style="{StaticResource OptionsCategoryIconStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <ToolTipService.ToolTip>
                        <ToolTip
                            x:Uid="GeneralSectionDescription"
                            ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}"
                            MaxWidth="300" />
                    </ToolTipService.ToolTip>
                    <TextBlock x:Uid="GeneralSectionTitle" Style="{StaticResource OptionsCategoryTitleStyle}" />
                </StackPanel>
            </Grid>
            <Grid
                AutomationProperties.AutomationId="LanguageSection"
                ColumnSpacing="12"
                RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="LanguageSectionTitle"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <ComboBox
                    x:Name="LanguageSelector"
                    x:Uid="LanguageSelector"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="LanguageSelector"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                <InfoBar
                    x:Name="LanguageRestartNotice"
                    x:Uid="LanguageRestartNotice"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="LanguageRestartNotice"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsLanguageRestartRequired, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="LanguageRestartButton"
                            AutomationProperties.AutomationId="LanguageRestartButton"
                            Click="OnRestartForLanguageClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Name="LanguageRestartError"
                    x:Uid="LanguageRestartError"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="LanguageRestartError"
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsLanguageRestartErrorVisible, Mode=OneWay}"
                    Severity="Error" />
            </Grid>
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <Grid ColumnSpacing="12" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="CloseWhenInactiveLabel"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <ToggleSwitch
                    x:Name="CloseWhenInactiveToggle"
                    x:Uid="CloseWhenInactiveToggle"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="CloseWhenInactiveToggle"
                    HorizontalAlignment="Right"
                    IsOn="{x:Bind ViewModel.CloseWhenInactive, Mode=TwoWay}"
                    OffContent=""
                    OnContent=""
                    VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <Grid ColumnSpacing="10" RowSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="ShareCaptureFolderTitle"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="ShareCaptureFolderPath"
                    x:Uid="ShareCaptureFolderPath"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ShareCaptureFolderPath"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <Button
                    x:Uid="ShareCaptureFolderBrowseButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="ShareCaptureFolderBrowseButton"
                    Click="OnShareCaptureFolderBrowseClicked"
                    Padding="10,5" />
                <Button
                    x:Uid="ShareCaptureFolderResetButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="ShareCaptureFolderResetButton"
                    Click="OnShareCaptureFolderResetClicked"
                    Padding="10,5"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
