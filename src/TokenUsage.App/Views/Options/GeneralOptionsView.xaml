<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Options.GeneralOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:converters="using:TokenUsage.App.Converters"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:TokenUsage.App.ViewModels"
    mc:Ignorable="d">

    <Border
        AutomationProperties.AutomationId="GeneralSection"
        Style="{StaticResource OptionsCategoryCardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="9" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Grid.RowSpan="2" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE713;" VerticalAlignment="Top" />
                <TextBlock x:Uid="GeneralSectionTitle" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="GeneralSectionDescription" Grid.Row="1" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
            </Grid>
            <StackPanel
                AutomationProperties.AutomationId="LanguageSection"
                Spacing="8">
                <TextBlock
                    x:Uid="LanguageSectionTitle"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="LanguageSelector"
                    x:Uid="LanguageSelector"
                    AutomationProperties.AutomationId="LanguageSelector"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                <InfoBar
                    x:Name="LanguageRestartNotice"
                    x:Uid="LanguageRestartNotice"
                    AutomationProperties.AutomationId="LanguageRestartNotice"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsLanguageRestartRequired, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="LanguageRestartButton"
                            AutomationProperties.AutomationId="LanguageRestartButton"
                            Click="OnRestartForLanguageClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Name="LanguageRestartError"
                    x:Uid="LanguageRestartError"
                    AutomationProperties.AutomationId="LanguageRestartError"
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsLanguageRestartErrorVisible, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <ToggleSwitch
                x:Name="CloseWhenInactiveToggle"
                x:Uid="CloseWhenInactiveToggle"
                AutomationProperties.AutomationId="CloseWhenInactiveToggle"
                HorizontalAlignment="Stretch"
                IsOn="{x:Bind ViewModel.CloseWhenInactive, Mode=TwoWay}"
                OffContent=""
                OnContent="" />
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <Grid ColumnSpacing="10" RowSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="ShareCaptureFolderTitle"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="ShareCaptureFolderPath"
                    x:Uid="ShareCaptureFolderPath"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ShareCaptureFolderPath"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <Button
                    x:Uid="ShareCaptureFolderBrowseButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="ShareCaptureFolderBrowseButton"
                    Click="OnShareCaptureFolderBrowseClicked"
                    Padding="10,5" />
                <Button
                    x:Uid="ShareCaptureFolderResetButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="ShareCaptureFolderResetButton"
                    Click="OnShareCaptureFolderResetClicked"
                    Padding="10,5"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
