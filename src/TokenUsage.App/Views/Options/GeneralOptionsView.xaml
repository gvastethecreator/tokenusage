<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Options.GeneralOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:converters="using:TokenUsage.App.Converters"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:TokenUsage.App.ViewModels"
    mc:Ignorable="d">

    <Border
        AutomationProperties.AutomationId="GeneralSection"
        Style="{StaticResource OptionsCategoryCardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="10" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE713;" Style="{StaticResource OptionsCategoryIconStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <ToolTipService.ToolTip>
                        <ToolTip
                            x:Uid="GeneralSectionDescription"
                            ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}"
                            MaxWidth="300" />
                    </ToolTipService.ToolTip>
                    <TextBlock x:Uid="GeneralSectionTitle" Style="{StaticResource OptionsCategoryTitleStyle}" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="12" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="CloseWhenInactiveLabel"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <ToggleButton
                    x:Name="CloseWhenInactiveToggle"
                    x:Uid="CloseWhenInactiveToggle"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="CloseWhenInactiveToggle"
                    HorizontalAlignment="Right"
                    IsChecked="{x:Bind ViewModel.CloseWhenInactive, Mode=TwoWay}"
                    Style="{StaticResource OptionsStateButtonStyle}"
                    VerticalAlignment="Center">
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Symbol="Cancel" />
                </ToggleButton>
            </Grid>
            <Grid ColumnSpacing="12" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="DataCollectionBackgroundLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <ToggleButton
                    x:Name="DataCollectionBackgroundToggle"
                    x:Uid="DataCollectionBackgroundToggle"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="DataCollectionBackgroundToggle"
                    HorizontalAlignment="Right"
                    IsChecked="{x:Bind ViewModel.IsBackgroundCollectionEnabled, Mode=TwoWay}"
                    Style="{StaticResource OptionsStateButtonStyle}"
                    VerticalAlignment="Center">
                    <ToolTipService.ToolTip>
                        <ToolTip
                            x:Uid="DataCollectionBackgroundTooltip"
                            ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}"
                            MaxWidth="300" />
                    </ToolTipService.ToolTip>
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Symbol="Sync" />
                </ToggleButton>
            </Grid>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="DataCollectionRefreshLabel"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="DataCollectionOpenRefreshSelector"
                    AutomationProperties.AutomationId="DataCollectionOpenRefreshSelector"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.DataCollectionRefreshOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedDataCollectionRefresh, Mode=TwoWay}" />
            </StackPanel>
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <Grid ColumnSpacing="12" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="AlertsMasterLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Uid="AlertsMasterDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleButton
                    x:Uid="AlertsMasterToggle"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="AlertsMasterToggle"
                    HorizontalAlignment="Right"
                    IsChecked="{x:Bind ViewModel.AreAlertsEnabled, Mode=TwoWay}"
                    Style="{StaticResource OptionsStateButtonStyle}"
                    VerticalAlignment="Center">
                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE7ED;" />
                </ToggleButton>
            </Grid>
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="QuotaAlertThresholdLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <NumberBox
                        x:Uid="QuotaAlertThresholdNumberBox"
                        AutomationProperties.AutomationId="QuotaAlertThresholdNumberBox"
                        IsEnabled="{x:Bind ViewModel.AreAlertControlsEnabled, Mode=OneWay}"
                        Maximum="99"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.QuotaAlertThresholdPercent, Mode=TwoWay}" />
                </StackPanel>
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="QuotaThresholdAlertLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        x:Uid="QuotaThresholdAlertToggle"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="QuotaThresholdAlertToggle"
                        IsEnabled="{x:Bind ViewModel.AreAlertControlsEnabled, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsQuotaThresholdAlertEnabled, Mode=TwoWay}"
                        Style="{StaticResource OptionsStateButtonStyle}">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE9D9;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="ExhaustionForecastAlertLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        x:Uid="ExhaustionForecastAlertToggle"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ExhaustionForecastAlertToggle"
                        IsEnabled="{x:Bind ViewModel.AreAlertControlsEnabled, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsExhaustionForecastAlertEnabled, Mode=TwoWay}"
                        Style="{StaticResource OptionsStateButtonStyle}">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE823;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="StaleDataAlertLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        x:Uid="StaleDataAlertToggle"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="StaleDataAlertToggle"
                        IsChecked="{x:Bind ViewModel.IsStaleDataAlertEnabled, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.AreAlertControlsEnabled, Mode=OneWay}"
                        Style="{StaticResource OptionsStateButtonStyle}">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE783;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="CredentialFailureAlertLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        x:Uid="CredentialFailureAlertToggle"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="CredentialFailureAlertToggle"
                        IsChecked="{x:Bind ViewModel.IsCredentialFailureAlertEnabled, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.AreAlertControlsEnabled, Mode=OneWay}"
                        Style="{StaticResource OptionsStateButtonStyle}">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE72E;" />
                    </ToggleButton>
                </Grid>
            </StackPanel>
            <Border Height="1" Background="{ThemeResource TokenUsageStrokeBrush}" />
            <Grid ColumnSpacing="8" RowSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="ShareCaptureFolderTitle"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="ShareCaptureFolderPath"
                    x:Uid="ShareCaptureFolderPath"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="ShareCaptureFolderPath"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="ShareCaptureFolderBrowseButton"
                        AutomationProperties.AutomationId="ShareCaptureFolderBrowseButton"
                        Click="OnShareCaptureFolderBrowseClicked"
                        Padding="10,5" />
                    <Button
                        x:Uid="ShareCaptureFolderResetButton"
                        AutomationProperties.AutomationId="ShareCaptureFolderResetButton"
                        Click="OnShareCaptureFolderResetClicked"
                        Padding="10,5"
                        Style="{StaticResource SubtleButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
