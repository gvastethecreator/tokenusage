<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WOpenUsage.App.Views.Options.ProvidersOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WOpenUsage.App.Controls"
    xmlns:converters="using:WOpenUsage.App.Converters"
    xmlns:dashboard="using:WOpenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:WOpenUsage.App.ViewModels"
    mc:Ignorable="d">

    <StackPanel
        AutomationProperties.AutomationId="ProvidersSectionNavigation"
        Spacing="6">
        <StackPanel Margin="2,0,2,4" Spacing="2">
            <TextBlock x:Uid="ProvidersSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="ProvidersSectionDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
        </StackPanel>
        <Button
            x:Name="OptionsProviderStatusButton"
            x:Uid="OptionsProviderStatusButton"
            AutomationProperties.AutomationId="OptionsProviderStatusButton"
            Command="{x:Bind ViewModel.ShowProviderStatusCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            MinHeight="56"
            Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE9D2;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Uid="OptionsProviderStatusLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="OptionsProviderStatusDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <FontIcon Grid.Column="2" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE76C;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
