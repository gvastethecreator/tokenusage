<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TokenUsage.App.Views.Options.UpdateOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border AutomationProperties.AutomationId="UpdateSection" Style="{StaticResource OptionsCategoryCardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Uid="UpdateSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="UpdateAutomaticLabel" Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="AutomaticUpdatesToggle" x:Uid="AutomaticUpdatesToggle" Grid.Column="1"
                        AutomationProperties.AutomationId="AutomaticUpdatesToggle" Style="{StaticResource OptionsInlineToggleStyle}"
                        IsEnabled="{x:Bind ViewModel.CanChangePreference, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.AutomaticUpdatesEnabled, Mode=TwoWay}" />
                </Grid>
                <TextBlock x:Uid="UpdateAutomaticDescription" Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="5">
                <TextBlock x:Name="UpdateStatus" AutomationProperties.AutomationId="UpdateStatus"
                    AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                <ProgressBar x:Uid="UpdateDownloadProgress" AutomationProperties.AutomationId="UpdateDownloadProgress"
                    Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLastCheck, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="UpdateSettingsError" Visibility="{x:Bind ViewModel.HasSettingsError, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="CheckAppUpdatesButton" AutomationProperties.AutomationId="CheckAppUpdatesButton"
                    Padding="10,6" Command="{x:Bind ViewModel.CheckUpdatesCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowCheckAction, Mode=OneWay}" />
                <Button x:Uid="DownloadAppUpdateButton" AutomationProperties.AutomationId="DownloadAppUpdateButton"
                    Padding="10,6" Command="{x:Bind ViewModel.DownloadAndInstallCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowDownloadAction, Mode=OneWay}" />
                <Button x:Uid="RetryAppUpdateButton" AutomationProperties.AutomationId="RetryAppUpdateButton"
                    Padding="10,6" Command="{x:Bind ViewModel.RetryInstallationCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowRetryAction, Mode=OneWay}" />
                <Button AutomationProperties.AutomationId="FinishAppUpdateButton"
                    Padding="10,6" Content="{x:Bind ViewModel.FinishActionText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RestartAndInstallCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" />
                <Button x:Uid="CancelAppUpdateButton" AutomationProperties.AutomationId="CancelAppUpdateButton"
                    Padding="10,6" Command="{x:Bind ViewModel.CancelUpdateCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
