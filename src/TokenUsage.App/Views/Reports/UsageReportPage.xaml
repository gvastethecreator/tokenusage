                                                        <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ValueText}" />
                                                    </StackPanel>
                                                </Grid>
                                                <controls:UsageTrendChart Grid.Column="1" Data="{x:Bind Trend}" PlotHeight="56" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Grid>
                                <Border
                                    Margin="0,2,0,0"
                                    Padding="0,10,0,0"
                                    BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <TextBlock x:Uid="UsageReportCompositionTitle" Style="{StaticResource ReportSectionLabelStyle}" VerticalAlignment="Center" />
