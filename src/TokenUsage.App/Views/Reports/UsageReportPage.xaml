                                    <TextBlock x:Uid="UsageReportShareColumn" Grid.Column="2" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportTokensColumn" Grid.Column="3" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCoverageColumn" Grid.Column="4" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsRepeater x:Name="ModelBreakdownRows" ItemsSource="{x:Bind ViewModel.ModelRows, Mode=OneWay}">
