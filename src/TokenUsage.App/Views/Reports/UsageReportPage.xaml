                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="4"
                                            MinColumnSpacing="14"
                                            MinItemWidth="240"
                                            MinRowSpacing="5"
                                            Orientation="Horizontal" />
