<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TokenUsage.App.Views.Reports.UsageReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:reports="using:TokenUsage.App.ViewModels.Reports"
    Background="{ThemeResource TokenUsageShellBrush}">
    <Page.Resources>
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TokenUsageSelectedBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TokenUsageSelectedPointerOverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TokenUsageSelectedPressedBrush" />
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="TokenUsageSelectedBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TokenUsageSelectedPointerOverBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="TokenUsageSelectedPressedBrush" />
        <Style x:Key="ReportCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TokenUsageCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource TokenUsageStrokeBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="ReportSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="45" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ReportToolbarToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="4">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="ActiveIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="ActiveIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="ActiveIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="TabContent"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
                            <Border
                                x:Name="ActiveIndicator"
                                Height="2"
                                Margin="8,0"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource TextFillColorPrimaryBrush}"
                                CornerRadius="1"
                                Opacity="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReportToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportToolbarButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="ReportResetCycleOptionTemplate" x:DataType="reports:UsageReportResetCycleOption">
            <StackPanel AutomationProperties.Name="{x:Bind AutomationName}" Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind AutomationName}">
                <TextBlock MaxWidth="420" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind DurationText}" />
            </StackPanel>
        </DataTemplate>
        <Style
            x:Key="ReportProviderTabStyle"
            BasedOn="{StaticResource ReportToolbarToggleButtonStyle}"
            TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportProviderCarouselButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="28" />
        </Style>
        <DataTemplate x:Key="ReportQuotaPillTemplate" x:DataType="dashboard:QuotaWindow">
            <Grid
                Padding="0,5,0,6"
                AutomationProperties.Name="{x:Bind DisplayAutomationName}"
                RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind LabelEvidenceText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind HasLabelEvidence}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Text="{x:Bind RemainingText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>
                <controls:AnimatedProgressBar
                    Grid.Row="1"
                    Height="12"
                    AutomationName="{x:Bind DisplayAutomationName}"
                    IndicatorScale="2.5"
                    RemainingValue="{x:Bind ColorRemainingPercent}"
                    TargetValue="{x:Bind RemainingPercent}" />
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ResetText}" TextTrimming="CharacterEllipsis">
                        <ToolTipService.ToolTip>
                            <ToolTip MaxWidth="332" Content="{x:Bind ResetText}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind UsedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis">
                        <ToolTipService.ToolTip>
                            <ToolTip MaxWidth="332" Content="{x:Bind UsedText}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </Grid>
                <TextBlock
                    Grid.Row="3"
                    AutomationProperties.Name="{x:Bind PaceAutomationName}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind PaceText}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasPace}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid
        x:Name="ReportCaptureSurface"
        Background="{ThemeResource TokenUsageShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="{ThemeResource TokenUsageShellBrush}"
            BorderBrush="{ThemeResource TokenUsageStrokeBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                x:Name="ReportHeaderRoot"
                MaxWidth="1280"
                Padding="20,14,20,12"
                HorizontalAlignment="Stretch"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="240" Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Uid="UsageReportTitle" FontSize="21" FontWeight="SemiBold" />
                            <Button
                                x:Name="ReportCoverageHintButton"
                                x:Uid="UsageReportCoverageHintButton"
                                AutomationProperties.AutomationId="UsageReportCoverageHintButton"
                                AutomationProperties.HelpText="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                                MinHeight="25"
                                MinWidth="25"
                                Padding="4"
                                Style="{StaticResource SubtleButtonStyle}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True">
                                        <StackPanel Width="320" Spacing="10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="UsageReportQualityTitle" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    FontFamily="Consolas"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ViewModel.SummaryCoverageText, Mode=OneWay}" />
                                            </Grid>
                                            <ProgressBar
                                                Height="6"
                                                Maximum="100"
                                                Value="{x:Bind ViewModel.PriceCoveragePercent, Mode=OneWay}" />
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.QualityRows, Mode=OneWay}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="reports:UsageReportQualityRow">
                                                        <Grid Padding="0,4" ColumnSpacing="16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                                                            <TextBlock Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind Value}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <Border
                                                Padding="10,8"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="5">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Border>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <FontIcon FontSize="13" Glyph="&#xE946;" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock
                                MaxWidth="360"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PeriodText, Mode=OneWay}" />
                            <Border
                                Padding="6,1"
                                AutomationProperties.AutomationId="UsageReportResetCount"
                                AutomationProperties.HelpText="{x:Bind ViewModel.ResetCountHelpText, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ResetCountText, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind ViewModel.HasResetCountSummary, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontSize="9" Glyph="&#xE895;" />
                                    <TextBlock FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ResetCountText, Mode=OneWay}" />
                                </StackPanel>
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock MaxWidth="288" Text="{x:Bind ViewModel.ResetCountHelpText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="ReportControlBar"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <RadioButton x:Uid="UsageReportGlobalButton" AutomationProperties.AutomationId="UsageReportGlobalButton" GroupName="UsageReportScopeTabs" IsChecked="{x:Bind ViewModel.IsGlobalScope, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Global" Click="OnScopeClick" />
                            <RadioButton x:Uid="UsageReportProviderButton" AutomationProperties.AutomationId="UsageReportProviderButton" GroupName="UsageReportScopeTabs" IsChecked="{x:Bind ViewModel.IsProviderScope, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.HasProviderOptions, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Provider" Click="OnScopeClick" />
                            <RadioButton x:Uid="UsageReportCompareButton" AutomationProperties.AutomationId="UsageReportCompareButton" GroupName="UsageReportScopeTabs" IsChecked="{x:Bind ViewModel.IsCompareScope, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Compare" Click="OnScopeClick" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.IsPeriodPickerVisible, Mode=OneWay}">
                        <Border Width="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource TokenUsageStrokeBrush}" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                            <ComboBox
                                x:Uid="UsageReportPeriodSelector"
                                AutomationProperties.AutomationId="UsageReportPeriodSelector"
                                ItemsSource="{x:Bind ViewModel.PeriodOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=OneWay}"
                                SelectionChanged="OnPeriodSelectionChanged"
                                Style="{StaticResource ReportToolbarComboBoxStyle}"
                                Width="124">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="reports:UsageReportPeriodOption">
                                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <RadioButton
                                x:Uid="UsageReportResetCycleButton"
                                AutomationProperties.AutomationId="UsageReportResetCycleButton"
                                IsChecked="{x:Bind ViewModel.IsResetCycleWindow, Mode=OneWay}"
                                Style="{StaticResource ReportToolbarToggleButtonStyle}"
                                Click="OnResetCycleClick"
                                Visibility="{x:Bind ViewModel.CanUseResetCycles, Mode=OneWay}" />
                        </StackPanel>
                        </StackPanel>
                        <Border Width="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource TokenUsageStrokeBrush}" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <RadioButton x:Uid="UsageReportCostButton" AutomationProperties.AutomationId="UsageReportCostButton" GroupName="UsageReportMetricTabs" IsChecked="{x:Bind ViewModel.IsCostMetric, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Cost" Click="OnMetricClick" />
                            <RadioButton x:Uid="UsageReportTokensButton" AutomationProperties.AutomationId="UsageReportTokensButton" GroupName="UsageReportMetricTabs" IsChecked="{x:Bind ViewModel.IsTokenMetric, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Tokens" Click="OnMetricClick" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsValueModeVisible, Mode=OneWay}">
                            <RadioButton x:Uid="UsageReportAbsoluteButton" AutomationProperties.AutomationId="UsageReportAbsoluteButton" GroupName="UsageReportValueModeTabs" IsChecked="{x:Bind ViewModel.IsAbsoluteValueMode, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Absolute" Click="OnValueModeClick" />
                            <RadioButton x:Uid="UsageReportShareButton" AutomationProperties.AutomationId="UsageReportShareButton" GroupName="UsageReportValueModeTabs" IsChecked="{x:Bind ViewModel.IsShareValueMode, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Share" Click="OnValueModeClick" />
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                            <Button x:Uid="UsageReportRefreshButton" AutomationProperties.AutomationId="UsageReportRefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" Padding="7" Style="{StaticResource ReportToolbarButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                x:Uid="UsageReportCaptureButton"
                                AutomationProperties.AutomationId="UsageReportCaptureButton"
                                Click="OnShareCaptureClick"
                                Padding="7"
                                Style="{StaticResource ReportToolbarButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE72D;" IsTextScaleFactorEnabled="False" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="ReportCaptureBrand"
                        Grid.Column="1"
                        AutomationProperties.AccessibilityView="Raw"
                        HorizontalAlignment="Right"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Image
                            Height="28"
                            Source="{ThemeResource TokenUsageAppIconSource}"
                            Width="28" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="TokenUsage"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="ReportScrollViewer"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
                <StackPanel
                    x:Name="ReportCaptureRoot"
                    MaxWidth="1280"
                    Padding="20,14,20,32"
                    Background="{ThemeResource TokenUsageShellBrush}"
                    HorizontalAlignment="Stretch"
                    Spacing="12">
                <Grid
                    x:Name="ReportProviderCarousel"
                    Height="40"
                    ColumnSpacing="4"
                    Visibility="{x:Bind ViewModel.IsProviderPickerVisible, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ReportPreviousProviderButton"
                        x:Uid="PreviousProviderTabButton"
                        AutomationProperties.AutomationId="UsageReportPreviousProviderButton"
                        Click="OnPreviousProviderTabClick"
                        Style="{StaticResource ReportProviderCarouselButtonStyle}">
                        <FontIcon FontSize="11" Glyph="&#xE76B;" />
                    </Button>
                    <Grid
                        x:Name="ReportProviderTabsViewport"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="UsageReportProviderSelector"
                        SizeChanged="OnProviderTabsViewportSizeChanged">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="ReportProviderTabsClip" />
                        </Grid.Clip>
                        <Grid x:Name="ReportProviderTabsTransitionRoot" Margin="2,0">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="ReportProviderTabsTransitionTransform" />
                            </Grid.RenderTransform>
                            <ItemsRepeater
                                x:Name="ReportProviderTabsRepeater"
                                ElementPrepared="OnProviderTabPrepared"
                                ItemsSource="{x:Bind VisibleProviderTabs, Mode=OneTime}">
                                <ItemsRepeater.Layout>
                                    <StackLayout
                                        x:Name="ReportProviderTabsLayout"
                                        Orientation="Horizontal"
                                        Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="reports:UsageReportProviderOption">
                                        <RadioButton
                                            AutomationProperties.AutomationId="{x:Bind ProviderId}"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            GroupName="UsageReportProviderTabs"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource ReportProviderTabStyle}"
                                            Tag="{x:Bind ProviderId}"
                                            ToolTipService.ToolTip="{x:Bind Name}"
                                            Click="OnProviderTabClick">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <controls:ProviderMarkImage Height="17" ProviderId="{x:Bind ProviderId}" Width="17" />
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Grid>
                    <Button
                        x:Name="ReportNextProviderButton"
                        x:Uid="NextProviderTabButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="UsageReportNextProviderButton"
                        Click="OnNextProviderTabClick"
                        Style="{StaticResource ReportProviderCarouselButtonStyle}">
                        <FontIcon FontSize="11" Glyph="&#xE76C;" />
                    </Button>
                </Grid>

                <StackPanel
                    x:Name="ReportCompareToolbar"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsCompareScope, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Uid="UsageReportCompareProvidersButton"
                            AutomationProperties.AutomationId="UsageReportCompareProvidersButton"
                            GroupName="UsageReportCompareAxisTabs"
                            IsChecked="{x:Bind ViewModel.IsCompareProvidersAxis, Mode=OneWay}"
                            Style="{StaticResource ReportToolbarToggleButtonStyle}"
                            Tag="Providers"
                            Click="OnCompareAxisClick" />
                        <RadioButton
                            x:Uid="UsageReportComparePeriodsButton"
                            AutomationProperties.AutomationId="UsageReportComparePeriodsButton"
                            GroupName="UsageReportCompareAxisTabs"
                            IsChecked="{x:Bind ViewModel.IsComparePeriodsAxis, Mode=OneWay}"
                            Style="{StaticResource ReportToolbarToggleButtonStyle}"
                            Tag="Periods"
                            Click="OnCompareAxisClick" />
                        <RadioButton
                            x:Uid="UsageReportCompareCyclesButton"
                            AutomationProperties.AutomationId="UsageReportCompareCyclesButton"
                            GroupName="UsageReportCompareAxisTabs"
                            IsChecked="{x:Bind ViewModel.IsCompareCyclesAxis, Mode=OneWay}"
                            Style="{StaticResource ReportToolbarToggleButtonStyle}"
                            Tag="Cycles"
                            Click="OnCompareAxisClick" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsCompareProviderPickersVisible, Mode=OneWay}">
                        <ComboBox
                            x:Uid="UsageReportCompareLeftProviderSelector"
                            AutomationProperties.AutomationId="UsageReportCompareLeftProviderSelector"
                            ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                            MinWidth="180"
                            SelectedItem="{x:Bind ViewModel.CompareLeftProvider, Mode=TwoWay}"
                            Style="{StaticResource ReportToolbarComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="reports:UsageReportProviderOption">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox
                            x:Uid="UsageReportCompareRightProviderSelector"
                            AutomationProperties.AutomationId="UsageReportCompareRightProviderSelector"
