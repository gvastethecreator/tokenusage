<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TokenUsage.App.Views.Reports.UsageReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TokenUsage.App.Controls"
    xmlns:dashboard="using:TokenUsage.App.ViewModels.Dashboard"
    xmlns:reports="using:TokenUsage.App.ViewModels.Reports"
    Background="{ThemeResource TokenUsageShellBrush}">
    <Page.Resources>
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TokenUsageSelectedBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TokenUsageSelectedPointerOverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TokenUsageSelectedPressedBrush" />
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="TokenUsageSelectedBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TokenUsageSelectedPointerOverBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="TokenUsageSelectedPressedBrush" />
        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="TokenUsageSelectedBrush" />
        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TokenUsageSelectedForegroundBrush" />
        <Style x:Key="ReportCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TokenUsageCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource TokenUsageStrokeBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="ReportSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="45" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ReportToolbarToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="4">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="ActiveIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="ActiveIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="ActiveIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="TabContent"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
                            <Border
                                x:Name="ActiveIndicator"
                                Height="2"
                                Margin="8,0"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource TextFillColorPrimaryBrush}"
                                CornerRadius="1"
                                Opacity="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReportToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportToolbarButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="ReportQuotaPillTemplate" x:DataType="dashboard:QuotaWindow">
            <Grid
                Width="232"
                AutomationProperties.Name="{x:Bind DisplayAutomationName}"
                ColumnSpacing="6"
                RowSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon FontSize="12" Glyph="{x:Bind IconGlyph}" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind RemainingText}" />
                <controls:AnimatedProgressBar
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Height="4"
                    AutomationName="{x:Bind DisplayAutomationName}"
                    RemainingValue="{x:Bind ColorRemainingPercent}"
                    TargetValue="{x:Bind RemainingPercent}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ResetText}"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis">
                    <ToolTipService.ToolTip>
                        <ToolTip MaxWidth="332" Content="{x:Bind ResetText}" ContentTemplate="{StaticResource TokenUsageWrappedToolTipTemplate}" />
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="ReportScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <Grid
                x:Name="ReportCaptureRoot"
                MaxWidth="1280"
                Padding="20,18,20,32"
                Background="{ThemeResource TokenUsageShellBrush}"
                HorizontalAlignment="Stretch"
                RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Uid="UsageReportTitle" FontSize="21" FontWeight="SemiBold" />
                            <Button
                                x:Name="ReportCoverageHintButton"
                                AutomationProperties.AutomationId="UsageReportCoverageHintButton"
                                AutomationProperties.Name="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                                AutomationProperties.HelpText="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}"
                                GotFocus="OnCoverageHintEntered"
                                LostFocus="OnCoverageHintExited"
                                MinHeight="25"
                                MinWidth="25"
                                Padding="4"
                                PointerEntered="OnCoverageHintEntered"
                                PointerExited="OnCoverageHintExited"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasCoverageHint, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Name="CoverageHintToolTip" MaxWidth="360" Placement="Bottom">
                                        <TextBlock MaxWidth="328" Text="{x:Bind ViewModel.CoverageHintText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <FontIcon FontSize="13" Glyph="&#xE946;" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}" />
                            <Border
                                Padding="6,1"
                                AutomationProperties.AutomationId="UsageReportResetCount"
                                AutomationProperties.HelpText="{x:Bind ViewModel.ResetCountHelpText, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ResetCountText, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind ViewModel.HasResetCountSummary, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontSize="9" Glyph="&#xE895;" />
                                    <TextBlock FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ResetCountText, Mode=OneWay}" />
                                </StackPanel>
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock MaxWidth="288" Text="{x:Bind ViewModel.ResetCountHelpText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="ReportControlBar"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <RadioButton x:Uid="UsageReportGlobalButton" AutomationProperties.AutomationId="UsageReportGlobalButton" GroupName="UsageReportScopeTabs" IsChecked="{x:Bind ViewModel.IsGlobalScope, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Global" Click="OnScopeClick" />
                            <RadioButton x:Uid="UsageReportProviderButton" AutomationProperties.AutomationId="UsageReportProviderButton" GroupName="UsageReportScopeTabs" IsChecked="{x:Bind ViewModel.IsProviderScope, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Provider" Click="OnScopeClick" />
                        </StackPanel>
                        <Border Width="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource TokenUsageStrokeBrush}" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <RadioButton x:Uid="UsageReport7DaysButton" AutomationProperties.AutomationId="UsageReport7DaysButton" GroupName="UsageReportPeriodTabs" IsChecked="{x:Bind ViewModel.IsSevenDays, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="7" Click="OnPeriodClick" />
                            <RadioButton x:Uid="UsageReport30DaysButton" AutomationProperties.AutomationId="UsageReport30DaysButton" GroupName="UsageReportPeriodTabs" IsChecked="{x:Bind ViewModel.IsThirtyDays, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="30" Click="OnPeriodClick" />
                            <RadioButton x:Uid="UsageReport90DaysButton" AutomationProperties.AutomationId="UsageReport90DaysButton" GroupName="UsageReportPeriodTabs" IsChecked="{x:Bind ViewModel.IsNinetyDays, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="90" Click="OnPeriodClick" />
                            <RadioButton
                                x:Uid="UsageReportResetCycleButton"
                                AutomationProperties.AutomationId="UsageReportResetCycleButton"
                                GroupName="UsageReportPeriodTabs"
                                IsChecked="{x:Bind ViewModel.IsResetCycleWindow, Mode=OneWay}"
                                Style="{StaticResource ReportToolbarToggleButtonStyle}"
                                Click="OnResetCycleClick"
                                Visibility="{x:Bind ViewModel.CanUseResetCycles, Mode=OneWay}" />
                        </StackPanel>
                        <Grid
                            Width="168"
                            ColumnSpacing="2"
                            Visibility="{x:Bind ViewModel.HasMultipleResetCycles, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Uid="UsageReportPreviousResetCycleButton"
                                AutomationProperties.AutomationId="UsageReportPreviousResetCycleButton"
                                Click="OnPreviousResetCycleClick"
                                IsEnabled="{x:Bind ViewModel.CanSelectPreviousResetCycle, Mode=OneWay}"
                                MinWidth="28"
                                Padding="6"
                                Style="{StaticResource ReportToolbarButtonStyle}"
                                Width="28">
                                <FontIcon FontSize="12" Glyph="&#xE76B;" />
                            </Button>
                            <ComboBox
                                x:Uid="UsageReportResetCycleSelector"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="UsageReportResetCycleSelector"
                                AutomationProperties.HelpText="{x:Bind ViewModel.ResetCycleHelpText, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.ResetCycleOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedResetCycle, Mode=TwoWay}"
                                Style="{StaticResource ReportToolbarComboBoxStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ResetCycleHelpText, Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="reports:UsageReportResetCycleOption">
                                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button
                                x:Uid="UsageReportNextResetCycleButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="UsageReportNextResetCycleButton"
                                Click="OnNextResetCycleClick"
                                IsEnabled="{x:Bind ViewModel.CanSelectNextResetCycle, Mode=OneWay}"
                                MinWidth="28"
                                Padding="6"
                                Style="{StaticResource ReportToolbarButtonStyle}"
                                Width="28">
                                <FontIcon FontSize="12" Glyph="&#xE76C;" />
                            </Button>
                        </Grid>
                        <Border Width="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource TokenUsageStrokeBrush}" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <RadioButton x:Uid="UsageReportCostButton" AutomationProperties.AutomationId="UsageReportCostButton" GroupName="UsageReportMetricTabs" IsChecked="{x:Bind ViewModel.IsCostMetric, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Cost" Click="OnMetricClick" />
                            <RadioButton x:Uid="UsageReportTokensButton" AutomationProperties.AutomationId="UsageReportTokensButton" GroupName="UsageReportMetricTabs" IsChecked="{x:Bind ViewModel.IsTokenMetric, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Tokens" Click="OnMetricClick" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsValueModeVisible, Mode=OneWay}">
                            <RadioButton x:Uid="UsageReportAbsoluteButton" AutomationProperties.AutomationId="UsageReportAbsoluteButton" GroupName="UsageReportValueModeTabs" IsChecked="{x:Bind ViewModel.IsAbsoluteValueMode, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Absolute" Click="OnValueModeClick" />
                            <RadioButton x:Uid="UsageReportShareButton" AutomationProperties.AutomationId="UsageReportShareButton" GroupName="UsageReportValueModeTabs" IsChecked="{x:Bind ViewModel.IsShareValueMode, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Share" Click="OnValueModeClick" />
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                            <Button x:Uid="UsageReportRefreshButton" AutomationProperties.AutomationId="UsageReportRefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" Padding="7" Style="{StaticResource ReportToolbarButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                x:Uid="UsageReportCaptureButton"
                                AutomationProperties.AutomationId="UsageReportCaptureButton"
                                Click="OnShareCaptureClick"
                                Padding="7"
                                Style="{StaticResource ReportToolbarButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE72D;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <Border Grid.Row="2" Padding="16,12" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="6" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,72" Spacing="12" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9D9;" />
                    <TextBlock x:Uid="UsageReportEmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Uid="UsageReportEmptyBody" MaxWidth="440" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Uid="UsageReportEmptyRefreshButton" AutomationProperties.AutomationId="UsageReportEmptyRefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ReportDataContent" Grid.Row="2" Spacing="12" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                    <ListView
                        x:Name="ReportProviderSelector"
                        AutomationProperties.AutomationId="UsageReportProviderSelector"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                        ContainerContentChanging="OnProviderContainerContentChanging"
                        SelectionChanged="OnProviderSelectionChanged"
                        SelectionMode="Single"
                        SizeChanged="OnProviderSelectorSizeChanged"
                        Visibility="{x:Bind ViewModel.IsProviderScope, Mode=OneWay}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding ProviderId}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="reports:UsageReportProviderOption">
                                <StackPanel Padding="16,8" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="8">
                                    <controls:ProviderMarkImage Height="17" ProviderId="{x:Bind ProviderId}" Width="17" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Style="{StaticResource ReportCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.7*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Padding="16,12" Spacing="3">
                                <TextBlock x:Uid="UsageReportSummaryTokensLabel" Style="{StaticResource ReportSectionLabelStyle}" />
                                <TextBlock x:Name="ReportSummaryTokensValue" FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.SummaryTokensText, Mode=OneWay}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="16,12" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Uid="UsageReportSummaryCostLabel" Style="{StaticResource ReportSectionLabelStyle}" />
                                    <TextBlock x:Name="ReportSummaryCostValue" FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.SummaryCostText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="16,12" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Uid="UsageReportSummaryCoverageLabel" Style="{StaticResource ReportSectionLabelStyle}" />
                                    <TextBlock x:Name="ReportSummaryCoverageValue" FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.SummaryCoverageText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="16,12" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Uid="UsageReportSummaryQualityLabel" Style="{StaticResource ReportSectionLabelStyle}" />
                                    <ProgressBar x:Name="ReportSummaryQualityProgress" Height="6" Maximum="100" Value="{x:Bind ViewModel.PriceCoveragePercent, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="ReportSummaryQualityValue" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SummaryQualityText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsGlobalScope, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <TextBlock x:Uid="UsageReportCompositionTitle" Style="{StaticResource ReportSectionLabelStyle}" VerticalAlignment="Center" />
                            <ItemsRepeater x:Name="ReportCompositionLegendRoot" HorizontalAlignment="Right" ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}" VerticalAlignment="Center">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="20" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="reports:UsageReportProviderRow">
                                        <Grid ColumnSpacing="7" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:ProviderColorSwatch Height="9" ProviderId="{x:Bind ProviderId}" VerticalAlignment="Center" Width="9" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                                <Run Text="{x:Bind Name}" /><Run Text="  " /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShareText}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                        <ItemsRepeater
                            x:Name="ReportCompositionBar"
                            Height="6"
                            HorizontalAlignment="Stretch"
                            ElementPrepared="OnReportCompositionElementPrepared"
                            ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                            SizeChanged="OnReportCompositionSizeChanged">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="reports:UsageReportProviderRow">
                                    <controls:ProviderColorSwatch Height="6" ProviderId="{x:Bind ProviderId}" Width="2" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Padding="14,10" Style="{StaticResource ReportCardStyle}">
                            <StackPanel Spacing="7">
                                <Grid>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" VerticalAlignment="Center" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                                        <RadioButton
                                            x:Name="GlobalCombinedChartButton"
                                            x:Uid="UsageReportCombinedChartButton"
                                            AutomationProperties.AutomationId="UsageReportCombinedChartButton"
                                            GroupName="UsageReportChartLayoutTabs"
                                            IsChecked="True"
                                            Style="{StaticResource ReportToolbarToggleButtonStyle}"
                                            Tag="Combined"
                                            Click="OnGlobalChartLayoutClick" />
                                        <RadioButton
                                            x:Name="GlobalSplitChartsButton"
                                            x:Uid="UsageReportSplitChartsButton"
                                            AutomationProperties.AutomationId="UsageReportSplitChartsButton"
                                            GroupName="UsageReportChartLayoutTabs"
                                            Style="{StaticResource ReportToolbarToggleButtonStyle}"
                                            Tag="Split"
                                            Click="OnGlobalChartLayoutClick" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="GlobalChartTransitionRoot">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="GlobalChartTransitionTransform" />
                                    </Grid.RenderTransform>
                                    <controls:UsageTrendChart
                                        x:Name="GlobalCombinedChart"
                                        AutomationProperties.AutomationId="UsageReportGlobalTrendChart"
                                        Data="{x:Bind ViewModel.Trend, Mode=OneWay}"
                                        PlotHeight="310" />
                                    <ItemsRepeater
                                        x:Name="GlobalSplitCharts"
                                        ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                                        Visibility="Collapsed">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="reports:UsageReportProviderRow">
                                            <Grid MinHeight="74" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Padding="3,0" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:ProviderMarkImage Height="16" ProviderId="{x:Bind ProviderId}" Width="16" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                        <TextBlock FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ValueText}" />
                                                    </StackPanel>
                                                </Grid>
                                                <controls:UsageTrendChart Grid.Column="1" Data="{x:Bind Trend}" PlotHeight="56" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border
                        Padding="14,10"
                        Style="{StaticResource ReportCardStyle}"
                        Visibility="{x:Bind ViewModel.IsProviderScope, Mode=OneWay}">
                        <StackPanel Spacing="7">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" />
                            <controls:UsageTrendChart x:Name="ProviderChartContentRoot" AutomationProperties.AutomationId="UsageReportTrendChart" Data="{x:Bind ViewModel.Trend, Mode=OneWay}" PlotHeight="250" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="12,8" Style="{StaticResource ReportCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Padding="8,2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportCacheStripCachedInputLabel" Style="{StaticResource ReportSectionLabelStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReportCachedInputValue" Grid.Column="1" FontFamily="Consolas" Text="{x:Bind ViewModel.CachedInputText, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Column="1" Padding="16,2" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportCacheStripUncachedInputLabel" Style="{StaticResource ReportSectionLabelStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReportUncachedInputValue" Grid.Column="1" FontFamily="Consolas" Text="{x:Bind ViewModel.UncachedInputText, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Column="2" Padding="16,2" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportCacheStripOutputLabel" Style="{StaticResource ReportSectionLabelStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ReportOutputTokensValue" Grid.Column="1" FontFamily="Consolas" Text="{x:Bind ViewModel.OutputTokensText, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="12,8"
                            Style="{StaticResource ReportCardStyle}"
                            Visibility="{x:Bind ViewModel.HasProviderLimits, Mode=OneWay}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="UsageReportLimitsTitle" FontWeight="SemiBold" Margin="0,1,0,0" VerticalAlignment="Top" />
                                <ItemsRepeater
                                    x:Name="ReportProviderLimitsContentRoot"
                                    Grid.Column="1"
                                    ItemTemplate="{StaticResource ReportQuotaPillTemplate}"
                                    ItemsSource="{x:Bind ViewModel.ProviderLimits, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="14" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Padding="14,10" Style="{StaticResource ReportCardStyle}">
                        <StackPanel Spacing="7">
                            <Grid>
                                <TextBlock x:Uid="UsageReportBreakdownTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                                    <RadioButton x:Uid="UsageReportModelButton" AutomationProperties.AutomationId="UsageReportModelButton" GroupName="UsageReportBreakdownTabs" IsChecked="{x:Bind ViewModel.IsModelBreakdown, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Model" Click="OnBreakdownClick" />
                                    <RadioButton x:Uid="UsageReportSourceButton" AutomationProperties.AutomationId="UsageReportSourceButton" GroupName="UsageReportBreakdownTabs" IsChecked="{x:Bind ViewModel.IsSourceBreakdown, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Source" Click="OnBreakdownClick" />
                                    <RadioButton x:Uid="UsageReportDayButton" AutomationProperties.AutomationId="UsageReportDayButton" GroupName="UsageReportBreakdownTabs" IsChecked="{x:Bind ViewModel.IsDayBreakdown, Mode=OneWay}" Style="{StaticResource ReportToolbarToggleButtonStyle}" Tag="Day" Click="OnBreakdownClick" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{x:Bind ViewModel.IsModelBreakdown, Mode=OneWay}">
                                <Grid Padding="0,7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportModelColumn" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCostColumn" Grid.Column="1" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportShareColumn" Grid.Column="2" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportTokensColumn" Grid.Column="3" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCoverageColumn" Grid.Column="4" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsRepeater x:Name="ModelBreakdownRows" ItemsSource="{x:Bind ViewModel.ModelRows, Mode=OneWay}">
                                    <ItemsRepeater.RenderTransform>
                                        <CompositeTransform x:Name="ModelBreakdownRowsTransform" />
                                    </ItemsRepeater.RenderTransform>
                                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="reports:UsageReportModelRow">
                                        <Grid Padding="0,9" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8"><controls:ProviderMarkImage Height="15" ProviderId="{x:Bind ProviderId}" Width="15" /><TextBlock Text="{x:Bind ModelName}" /></StackPanel>
                                            <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind CostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ShareText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CoverageText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate></ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.IsSourceBreakdown, Mode=OneWay}">
                                <Grid Padding="0,7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportSourceColumn" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportReportedColumn" Grid.Column="1" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportEstimatedColumn" Grid.Column="2" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportTokensColumn" Grid.Column="3" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCoverageColumn" Grid.Column="4" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsRepeater x:Name="SourceBreakdownRows" ItemsSource="{x:Bind ViewModel.SourceRows, Mode=OneWay}">
                                    <ItemsRepeater.RenderTransform>
                                        <CompositeTransform x:Name="SourceBreakdownRowsTransform" />
                                    </ItemsRepeater.RenderTransform>
                                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="reports:UsageReportSourceRow">
                                        <Grid Padding="0,9" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="140" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8"><controls:ProviderMarkImage Height="15" ProviderId="{x:Bind ProviderId}" Width="15" /><TextBlock Text="{x:Bind Name}" /></StackPanel>
                                            <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind ReportedCostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{x:Bind EstimatedCostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CoverageText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate></ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.IsDayBreakdown, Mode=OneWay}">
                                <Grid Padding="0,7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportDayColumn" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCostColumn" Grid.Column="1" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportTokensColumn" Grid.Column="2" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportEventsColumn" Grid.Column="3" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCoverageColumn" Grid.Column="4" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsRepeater x:Name="DayBreakdownRows" ItemsSource="{x:Bind ViewModel.DayRows, Mode=OneWay}">
                                    <ItemsRepeater.RenderTransform>
                                        <CompositeTransform x:Name="DayBreakdownRowsTransform" />
                                    </ItemsRepeater.RenderTransform>
                                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="reports:UsageReportDayRow">
                                        <Grid Padding="0,9" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DateText}" />
                                            <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind CostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind EventsText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CoverageText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate></ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Button
            x:Name="ReportCaptureFocusSink"
            Width="1"
            Height="1"
            AutomationProperties.AccessibilityView="Raw"
            HorizontalAlignment="Left"
            IsTabStop="False"
            Opacity="0"
            VerticalAlignment="Top" />
        <InfoBar
            x:Name="ShareStatusInfoBar"
            AutomationProperties.AutomationId="UsageReportShareStatusInfoBar"
            AutomationProperties.LiveSetting="Polite"
            Margin="20"
            MaxWidth="620"
            HorizontalAlignment="Center"
            IsClosable="True"
            IsOpen="False"
            VerticalAlignment="Top" />
    </Grid>
</Page>
