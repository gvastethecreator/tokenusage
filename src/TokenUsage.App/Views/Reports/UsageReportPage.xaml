                                            <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind ReportedCostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{x:Bind EstimatedCostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CoverageText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate></ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.IsDayBreakdown, Mode=OneWay}">
                                <Grid Padding="0,7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportDayColumn" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCostColumn" Grid.Column="1" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportTokensColumn" Grid.Column="2" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportEventsColumn" Grid.Column="3" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCoverageColumn" Grid.Column="4" TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsRepeater x:Name="DayBreakdownRows" ItemsSource="{x:Bind ViewModel.DayRows, Mode=OneWay}">
                                    <ItemsRepeater.RenderTransform>
                                        <CompositeTransform x:Name="DayBreakdownRowsTransform" />
                                    </ItemsRepeater.RenderTransform>
                                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="reports:UsageReportDayRow">
                                        <Grid Padding="0,9" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DateText}" />
                                            <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind CostText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind TokensText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind EventsText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CoverageText}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate></ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    <StackPanel
                        x:Name="ReportCompareContent"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsCompareScope, Mode=OneWay}">
                        <Border
                            AutomationProperties.AutomationId="UsageReportCompareCycleWarning"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="6"
                            Padding="12,9"
                            Visibility="{x:Bind ViewModel.HasCompareCycleWarning, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CompareCycleWarningText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportCardStyle}">
                            <Grid x:Name="ReportCompareSummary">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Padding="16,12" Spacing="3">
                                    <TextBlock Style="{StaticResource ReportSectionLabelStyle}" Text="{x:Bind ViewModel.CompareLeftLabel, Mode=OneWay}" />
                                    <TextBlock FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.CompareLeftCostText, Mode=OneWay}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CompareLeftTokensText, Mode=OneWay}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="16,12" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource ReportSectionLabelStyle}" Text="{x:Bind ViewModel.CompareRightLabel, Mode=OneWay}" />
                                        <TextBlock FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.CompareRightCostText, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CompareRightTokensText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="16,12" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="1,0,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Uid="UsageReportCompareDeltaColumn" Style="{StaticResource ReportSectionLabelStyle}" />
                                        <TextBlock FontFamily="Consolas" FontSize="24" Text="{x:Bind ViewModel.CompareDeltaCostText, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CompareDeltaTokensText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Padding="14,10" Style="{StaticResource ReportCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" />
                                <controls:UsageTrendChart
                                    x:Name="ReportCompareChart"
                                    AutomationProperties.AutomationId="UsageReportCompareTrendChart"
                                    Data="{x:Bind ViewModel.Trend, Mode=OneWay}"
                                    PlotHeight="250" />
                            </StackPanel>
                        </Border>
                        <Border Padding="14,10" Style="{StaticResource ReportCardStyle}">
                            <StackPanel Spacing="7">
                                <Grid Padding="0,7" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="UsageReportCompareMetricColumn" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Uid="UsageReportCompareLeftColumn" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Right" />
                                    <TextBlock x:Uid="UsageReportCompareRightColumn" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Right" />
                                    <TextBlock x:Uid="UsageReportCompareDeltaColumn" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Right" />
                                </Grid>
                                <ItemsRepeater x:Name="ReportCompareRows" ItemsSource="{x:Bind ViewModel.CompareRows, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="reports:UsageReportCompareRow">
                                            <Grid Padding="0,9" BorderBrush="{ThemeResource TokenUsageStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Metric}" />
                                                <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind LeftText}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{x:Bind RightText}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" FontFamily="Consolas" Text="{x:Bind DeltaText}" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
        </ScrollViewer>
        <Border
            Grid.Row="1"
            Background="{ThemeResource TokenUsageShellBrush}"
            Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="12"
                VerticalAlignment="Center">
                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}" />
                <TextBlock
                    x:Uid="UsageReportLoading"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <Button
            x:Name="ReportCaptureFocusSink"
            Width="1"
            Height="1"
            AutomationProperties.AccessibilityView="Raw"
            HorizontalAlignment="Left"
            IsTabStop="False"
            Opacity="0"
            VerticalAlignment="Top" />
        <InfoBar
            x:Name="ShareStatusInfoBar"
            AutomationProperties.AutomationId="UsageReportShareStatusInfoBar"
            AutomationProperties.LiveSetting="Polite"
            Margin="20"
            MaxWidth="620"
            HorizontalAlignment="Center"
            IsClosable="True"
            IsOpen="False"
            VerticalAlignment="Top" />
    </Grid>
</Page>
