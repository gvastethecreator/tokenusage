<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WOpenUsage.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WOpenUsage.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DashboardCardCornerRadius">12</CornerRadius>
            <SolidColorBrush x:Key="ProviderAntigravityBrush" Color="#FF4285F4" />
            <SolidColorBrush x:Key="ProviderClaudeBrush" Color="#FFDE7356" />
            <SolidColorBrush x:Key="ProviderCodexBrush" Color="#FF10A37F" />
            <SolidColorBrush x:Key="ProviderFallbackBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ProviderGrokBrush" Color="#FF98989D" />
            <SolidColorBrush x:Key="ProviderHighContrastBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ProviderOpenCodeBrush" Color="#FFAEAEB2" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
