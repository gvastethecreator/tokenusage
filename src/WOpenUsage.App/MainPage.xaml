<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WOpenUsage.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        x:Name="FlyoutChrome"
        Padding="14"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Uid="ProviderHeader"
                    Grid.Column="0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsUsageSurface, Mode=OneWay}" />

                <TextBlock
                    x:Uid="OptionsHeader"
                    Grid.Column="0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}" />

                <Button
                    x:Name="HeaderRefreshButton"
                    x:Uid="HeaderRefreshButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="HeaderRefreshButton"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Padding="8"
                    Visibility="{x:Bind ViewModel.IsUsageSurface, Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="&#xE72C;" />
                </Button>

                <Button
                    x:Name="OptionsBackButton"
                    x:Uid="OptionsBackButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="OptionsBackButton"
                    Command="{x:Bind ViewModel.CloseOptionsCommand}"
                    Padding="8"
                    Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="&#xE72B;" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                MinHeight="112"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                        <ProgressRing
                            x:Name="LoadingProgressRing"
                            x:Uid="LoadingProgressRing"
                            AutomationProperties.AutomationId="LoadingProgressRing"
                            Height="36"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Width="36" />
                        <TextBlock
                            x:Uid="LoadingLabel"
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <TextBlock
                            x:Uid="EmptyTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Uid="EmptyBody"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Name="EmptyOpenOptionsButton"
                            x:Uid="EmptyOpenOptionsButton"
                            AutomationProperties.AutomationId="EmptyOpenOptionsButton"
                            Command="{x:Bind ViewModel.OpenOptionsCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="CloseWhenInactiveToggle"
                        x:Uid="CloseWhenInactiveToggle"
                        AutomationProperties.AutomationId="CloseWhenInactiveToggle"
                        HorizontalAlignment="Stretch"
                        IsOn="{x:Bind ViewModel.CloseWhenInactive, Mode=TwoWay}"
                        OffContent=""
                        OnContent=""
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Uid="FlyoutFooterIdentity"
                    Grid.Column="0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="FooterOptionsButton"
                    x:Uid="FooterOptionsButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="FooterOptionsButton"
                    Command="{x:Bind ViewModel.OpenOptionsCommand}"
                    Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Glyph="&#xE713;" />
                        <TextBlock
                            x:Uid="FooterOptionsLabel"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Page>
