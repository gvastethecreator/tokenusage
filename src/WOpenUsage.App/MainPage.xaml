<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WOpenUsage.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WOpenUsage.App.Controls"
    xmlns:converters="using:WOpenUsage.App.Converters"
    xmlns:sample="using:WOpenUsage.App.ViewModels.Sample"
    xmlns:viewModels="using:WOpenUsage.App.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:VercelGatewayStatusSeverityConverter
            x:Key="VercelGatewayStatusSeverityConverter" />
        <Style
            x:Key="DashboardAmountTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            x:Key="DashboardHeadingTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            x:Key="DashboardCompactStrongTextBlockStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            x:Key="DashboardCaptionTextBlockStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AppearanceDensityStates">
                <VisualState x:Name="RegularDensity">
                    <VisualState.Setters>
                        <Setter Target="FlyoutChrome.Padding" Value="14" />
                        <Setter Target="RootLayout.RowSpacing" Value="10" />
                        <Setter Target="EmptyStateStack.Spacing" Value="12" />
                        <Setter Target="UnavailableStateStack.Spacing" Value="12" />
                        <Setter Target="OptionsStack.Spacing" Value="12" />
                        <Setter Target="DashboardStack.Spacing" Value="10" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactDensity">
                    <VisualState.Setters>
                        <Setter Target="FlyoutChrome.Padding" Value="12" />
                        <Setter Target="RootLayout.RowSpacing" Value="8" />
                        <Setter Target="EmptyStateStack.Spacing" Value="8" />
                        <Setter Target="UnavailableStateStack.Spacing" Value="8" />
                        <Setter Target="OptionsStack.Spacing" Value="8" />
                        <Setter Target="DashboardStack.Spacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AppearanceLayoutStates">
                <VisualState x:Name="NarrowAppearanceLayout" />
                <VisualState x:Name="WideAppearanceLayout">
                    <VisualState.Setters>
                        <Setter Target="AppearanceSettingsGrid.ColumnSpacing" Value="12" />
                        <Setter Target="AppearanceSettingsValueColumn.Width" Value="Auto" />
                        <Setter Target="AppearanceDensityLabel.(Grid.Row)" Value="1" />
                        <Setter Target="AppearanceDensitySelector.(Grid.Row)" Value="1" />
                        <Setter Target="AppearanceDensitySelector.(Grid.Column)" Value="1" />
                        <Setter Target="AppearanceDensitySelector.MinWidth" Value="144" />
                        <Setter Target="AppearanceTransparencyLabel.(Grid.Row)" Value="2" />
                        <Setter Target="AppearanceTransparencyToggle.(Grid.Row)" Value="2" />
                        <Setter Target="AppearanceTransparencyToggle.(Grid.Column)" Value="1" />
                        <Setter Target="AppearanceTransparencyToggle.HorizontalAlignment" Value="Right" />
                        <Setter Target="AppearanceUsageLabel.(Grid.Row)" Value="3" />
                        <Setter Target="AppearanceUsageSelector.(Grid.Row)" Value="3" />
                        <Setter Target="AppearanceUsageSelector.(Grid.Column)" Value="1" />
                        <Setter Target="AppearanceUsageSelector.MinWidth" Value="144" />
                        <Setter Target="AppearanceResetTimeLabel.(Grid.Row)" Value="4" />
                        <Setter Target="AppearanceResetTimeSelector.(Grid.Row)" Value="4" />
                        <Setter Target="AppearanceResetTimeSelector.(Grid.Column)" Value="1" />
                        <Setter Target="AppearanceResetTimeSelector.MinWidth" Value="144" />
                        <Setter Target="AppearanceThemeSelector.(Grid.Row)" Value="0" />
                        <Setter Target="AppearanceThemeSelector.(Grid.Column)" Value="1" />
                        <Setter Target="AppearanceThemeSelector.MinWidth" Value="144" />
                        <Setter Target="AppearanceStatus.(Grid.Row)" Value="5" />
                        <Setter Target="AppearanceStatus.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border
            x:Name="OpaqueSurface"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            IsHitTestVisible="False" />
        <Border
            x:Name="FlyoutChrome"
            SizeChanged="OnFlyoutChromeSizeChanged"
            Padding="14"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid x:Name="RootLayout" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsUsageSurface, Mode=OneWay}">
                    <TextBlock
                        x:Uid="ProviderHeader"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        VerticalAlignment="Center" />
                    <Border
                        Padding="7,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsSampleContext, Mode=OneWay}">
                        <TextBlock
                            x:Uid="SampleBadge"
                            AutomationProperties.AutomationId="SampleBadge"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>

                <TextBlock
                    x:Uid="OptionsHeader"
                    Grid.Column="0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}" />

                <Button
                    x:Name="HeaderRefreshButton"
                    x:Uid="HeaderRefreshButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="HeaderRefreshButton"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Padding="8"
                    Visibility="{x:Bind ViewModel.IsUsageSurface, Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        IsTextScaleFactorEnabled="False"
                        Glyph="&#xE72C;" />
                </Button>

                <Button
                    x:Name="OptionsBackButton"
                    x:Uid="OptionsBackButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="OptionsBackButton"
                    Command="{x:Bind ViewModel.CloseOptionsCommand}"
                    Padding="8"
                    Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        IsTextScaleFactorEnabled="False"
                        Glyph="&#xE72B;" />
                </Button>
            </Grid>

            <ScrollViewer
                x:Name="BodyScrollViewer"
                Grid.Row="1"
                AutomationProperties.AutomationId="BodyScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <Grid MinHeight="112">
                    <Border
                        MinHeight="112"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsCardSurface, Mode=OneWay}">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                                <ProgressRing
                                    x:Name="LoadingProgressRing"
                                    x:Uid="LoadingProgressRing"
                                    AutomationProperties.AutomationId="LoadingProgressRing"
                                    Height="36"
                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    Width="36" />
                                <TextBlock
                                    x:Uid="LoadingLabel"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="{x:Bind ViewModel.IsLiveLoading, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="SampleLoadingLabel"
                                    AutomationProperties.AutomationId="SampleLoadingLabel"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="{x:Bind ViewModel.IsSampleLoading, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="EmptyStateStack"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                                <TextBlock
                                    x:Uid="EmptyTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Uid="EmptyBody"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    x:Name="EmptyOpenOptionsButton"
                                    x:Uid="EmptyOpenOptionsButton"
                                    AutomationProperties.AutomationId="EmptyOpenOptionsButton"
                                    Command="{x:Bind ViewModel.OpenOptionsCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="UnavailableStateStack"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsSampleUnavailable, Mode=OneWay}">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UnavailableTitle, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UnavailableBody, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    x:Name="SampleRetryButton"
                                    AutomationProperties.AutomationId="SampleRetryButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.RetryAutomationName, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    Content="{x:Bind ViewModel.RetryButtonText, Mode=OneWay}"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="OptionsStack"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsOptions, Mode=OneWay}">
                                <Grid
                                    AutomationProperties.AutomationId="OptionsSectionNavigation"
                                    ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="OptionsGeneralButton"
                                        x:Uid="OptionsGeneralButton"
                                        AutomationProperties.AutomationId="OptionsGeneralButton"
                                        Command="{x:Bind ViewModel.ShowGeneralOptionsCommand}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="36">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <TextBlock x:Uid="OptionsGeneralLabel" />
                                            <Border Height="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1" Visibility="{x:Bind ViewModel.IsGeneralOptionsSection, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="OptionsAppearanceButton"
                                        x:Uid="OptionsAppearanceButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="OptionsAppearanceButton"
                                        Command="{x:Bind ViewModel.ShowAppearanceOptionsCommand}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="36">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <TextBlock x:Uid="OptionsAppearanceLabel" />
                                            <Border Height="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1" Visibility="{x:Bind ViewModel.IsAppearanceOptionsSection, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="OptionsProvidersButton"
                                        x:Uid="OptionsProvidersButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="OptionsProvidersButton"
                                        Command="{x:Bind ViewModel.ShowProvidersOptionsCommand}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="36">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <TextBlock x:Uid="OptionsProvidersLabel" />
                                            <Border Height="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1" Visibility="{x:Bind ViewModel.IsProvidersOptionsSection, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border
                                    AutomationProperties.AutomationId="AppearanceSection"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="10,4"
                                    Visibility="{x:Bind ViewModel.IsAppearanceOptionsSection, Mode=OneWay}">
                                    <Expander
                                        x:Uid="AppearanceExpander"
                                        AutomationProperties.AutomationId="AppearanceExpander"
                                        IsEnabled="{x:Bind ViewModel.IsAppearanceEditable, Mode=OneWay}"
                                        IsExpanded="False">
                                        <Grid x:Name="AppearanceSettingsGrid" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition x:Name="AppearanceSettingsValueColumn" Width="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                x:Name="AppearanceThemeLabel"
                                                x:Uid="AppearanceThemeLabel"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                x:Name="AppearanceThemeSelector"
                                                x:Uid="AppearanceThemeSelector"
                                                AutomationProperties.AutomationId="AppearanceThemeSelector"
                                                DisplayMemberPath="DisplayName"
                                                Grid.Row="1"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                                SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                                            <TextBlock
                                                x:Name="AppearanceDensityLabel"
                                                x:Uid="AppearanceDensityLabel"
                                                Grid.Row="2"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                x:Name="AppearanceDensitySelector"
                                                x:Uid="AppearanceDensitySelector"
                                                Grid.Row="3"
                                                AutomationProperties.AutomationId="AppearanceDensitySelector"
                                                DisplayMemberPath="DisplayName"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind ViewModel.DensityOptions}"
                                                SelectedItem="{x:Bind ViewModel.SelectedDensity, Mode=TwoWay}" />
                                            <TextBlock
                                                x:Name="AppearanceTransparencyLabel"
                                                x:Uid="AppearanceTransparencyLabel"
                                                Grid.Row="4"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords"
                                                VerticalAlignment="Center" />
                                            <ToggleSwitch
                                                x:Name="AppearanceTransparencyToggle"
                                                x:Uid="AppearanceTransparencyToggle"
                                                Grid.Row="5"
                                                AutomationProperties.AutomationId="AppearanceTransparencyToggle"
                                                HorizontalAlignment="Left"
                                                IsOn="{x:Bind ViewModel.IncreaseTransparency, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent="" />
                                            <TextBlock
                                                x:Name="AppearanceUsageLabel"
                                                x:Uid="AppearanceUsageLabel"
                                                Grid.Row="6"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                x:Name="AppearanceUsageSelector"
                                                x:Uid="AppearanceUsageSelector"
                                                Grid.Row="7"
                                                AutomationProperties.AutomationId="AppearanceUsageSelector"
                                                DisplayMemberPath="DisplayName"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind ViewModel.UsageDisplayOptions}"
                                                SelectedItem="{x:Bind ViewModel.SelectedUsageDisplay, Mode=TwoWay}" />
                                            <TextBlock
                                                x:Name="AppearanceResetTimeLabel"
                                                x:Uid="AppearanceResetTimeLabel"
                                                Grid.Row="8"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                x:Name="AppearanceResetTimeSelector"
                                                x:Uid="AppearanceResetTimeSelector"
                                                Grid.Row="9"
                                                AutomationProperties.AutomationId="AppearanceResetTimeSelector"
                                                DisplayMemberPath="DisplayName"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{x:Bind ViewModel.ResetTimeDisplayOptions}"
                                                SelectedItem="{x:Bind ViewModel.SelectedResetTimeDisplay, Mode=TwoWay}" />
                                            <InfoBar
                                                x:Name="AppearanceStatus"
                                                Grid.Row="10"
                                                AutomationProperties.AutomationId="AppearanceStatus"
                                                AutomationProperties.LiveSetting="Polite"
                                                IsClosable="False"
                                                IsOpen="{x:Bind ViewModel.IsAppearanceStatusVisible, Mode=OneWay}"
                                                Message="{x:Bind ViewModel.AppearanceStatusText, Mode=OneWay}"
                                                Severity="Warning" />
                                        </Grid>
                                    </Expander>
                                </Border>
                                <Border
                                    AutomationProperties.AutomationId="LanguageSection"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="10,8"
                                    Visibility="{x:Bind ViewModel.IsGeneralOptionsSection, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            x:Uid="LanguageSectionTitle"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <ComboBox
                                            x:Name="LanguageSelector"
                                            x:Uid="LanguageSelector"
                                            AutomationProperties.AutomationId="LanguageSelector"
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                                        <InfoBar
                                            x:Name="LanguageRestartNotice"
                                            x:Uid="LanguageRestartNotice"
                                            AutomationProperties.AutomationId="LanguageRestartNotice"
                                            AutomationProperties.LiveSetting="Polite"
                                            IsClosable="False"
                                            IsOpen="{x:Bind ViewModel.IsLanguageRestartRequired, Mode=OneWay}"
                                            Severity="Informational">
                                            <InfoBar.ActionButton>
                                                <Button
                                                    x:Uid="LanguageRestartButton"
                                                    AutomationProperties.AutomationId="LanguageRestartButton"
                                                    Click="OnRestartForLanguageClicked" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>
                                        <InfoBar
                                            x:Name="LanguageRestartError"
                                            x:Uid="LanguageRestartError"
                                            AutomationProperties.AutomationId="LanguageRestartError"
                                            AutomationProperties.LiveSetting="Assertive"
                                            IsClosable="False"
                                            IsOpen="{x:Bind ViewModel.IsLanguageRestartErrorVisible, Mode=OneWay}"
                                            Severity="Error" />
                                    </StackPanel>
                                </Border>
                                <ToggleSwitch
                                    x:Name="CloseWhenInactiveToggle"
                                    x:Uid="CloseWhenInactiveToggle"
                                    AutomationProperties.AutomationId="CloseWhenInactiveToggle"
                                    HorizontalAlignment="Stretch"
                                    IsOn="{x:Bind ViewModel.CloseWhenInactive, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    Visibility="{x:Bind ViewModel.IsGeneralOptionsSection, Mode=OneWay}" />
                                <ToggleSwitch
                                    x:Name="SampleModeToggle"
                                    x:Uid="SampleModeToggle"
                                    AutomationProperties.AutomationId="SampleModeToggle"
                                    HorizontalAlignment="Stretch"
                                    IsOn="{x:Bind ViewModel.IsSampleModeEnabled, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    Visibility="{x:Bind ViewModel.IsGeneralOptionsSection, Mode=OneWay}" />
                                <ComboBox
                                    x:Name="SampleScenarioCombo"
                                    x:Uid="SampleScenarioCombo"
                                    AutomationProperties.AutomationId="SampleScenarioCombo"
                                    DisplayMemberPath="DisplayName"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.IsSampleScenarioEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.SampleScenarios}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSampleScenario, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.IsGeneralOptionsSection, Mode=OneWay}" />

                                <Border
                                    x:Name="DashboardLayoutSection"
                                    AutomationProperties.AutomationId="DashboardLayoutSection"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="10,4"
                                    Visibility="{x:Bind ViewModel.IsProvidersOptionsSection, Mode=OneWay}">
                                    <Expander
                                        x:Uid="DashboardLayoutExpander"
                                        AutomationProperties.AutomationId="DashboardLayoutExpander"
                                        IsExpanded="False">
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                x:Uid="DashboardLayoutDescription"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords" />
                                            <InfoBar
                                                x:Name="DashboardLayoutStatus"
                                                AutomationProperties.AutomationId="DashboardLayoutStatus"
                                                AutomationProperties.LiveSetting="Polite"
                                                IsClosable="False"
                                                IsOpen="{x:Bind ViewModel.IsDashboardLayoutStatusVisible, Mode=OneWay}"
                                                Message="{x:Bind ViewModel.DashboardLayoutStatusText, Mode=OneWay}"
                                                Severity="Warning" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    x:Uid="DashboardLayoutUndoButton"
                                                    Grid.Column="1"
                                                    AutomationProperties.AutomationId="DashboardLayoutUndoButton"
                                                    Click="OnDashboardLayoutUndoClicked"
                                                    IsEnabled="{x:Bind ViewModel.CanUndoDashboardLayout, Mode=OneWay}"
                                                    MinHeight="32"
                                                    Padding="10,5" />
                                                <Button
                                                    x:Uid="DashboardLayoutResetButton"
                                                    Grid.Column="2"
                                                    AutomationProperties.AutomationId="DashboardLayoutResetButton"
                                                    Click="OnDashboardLayoutResetClicked"
                                                    IsEnabled="{x:Bind ViewModel.IsDashboardLayoutEditable, Mode=OneWay}"
                                                    MinHeight="32"
                                                    Padding="10,5" />
                                            </Grid>
                                            <ItemsControl
                                                AutomationProperties.AutomationId="DashboardLayoutProviderList"
                                                IsEnabled="{x:Bind ViewModel.IsDashboardLayoutEditable, Mode=OneWay}"
                                                ItemsSource="{x:Bind ViewModel.DashboardLayoutProviders, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.HasDashboardLayoutProviders, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:DashboardProviderLayoutRow">
                                                        <Border
                                                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                            AutomationProperties.Name="{x:Bind Name}"
                                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            Padding="0,4">
                                                            <StackPanel>
                                                            <Grid ColumnSpacing="4" MinHeight="36">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="32" />
                                                                </Grid.ColumnDefinitions>
                                                                <controls:ProviderMarkImage
                                                                    Height="16"
                                                                    ProviderId="{x:Bind ProviderId}"
                                                                    VerticalAlignment="Center"
                                                                    Width="16" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                                <Button
                                                                 x:Uid="DashboardProviderMoveUpButton"
                                                                 Grid.Column="2"
                                                                 AutomationProperties.AutomationId="{x:Bind MoveUpAutomationId}"
                                                                 AutomationProperties.Name="{x:Bind MoveUpAutomationName}"
                                                                Click="OnDashboardProviderMoveUpClicked"
                                                                IsEnabled="{x:Bind CanMoveUp}"
                                                                MinHeight="32"
                                                                MinWidth="32"
                                                                Padding="6"
                                                                Style="{StaticResource SubtleButtonStyle}"
                                                                Tag="{x:Bind ProviderId}">
                                                                <FontIcon
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    FontSize="12"
                                                                    Glyph="&#xE74A;"
                                                                    IsTextScaleFactorEnabled="False" />
                                                                </Button>
                                                                <Button
                                                                 x:Uid="DashboardProviderMoveDownButton"
                                                                 Grid.Column="3"
                                                                 AutomationProperties.AutomationId="{x:Bind MoveDownAutomationId}"
                                                                 AutomationProperties.Name="{x:Bind MoveDownAutomationName}"
                                                                Click="OnDashboardProviderMoveDownClicked"
                                                                IsEnabled="{x:Bind CanMoveDown}"
                                                                MinHeight="32"
                                                                MinWidth="32"
                                                                Padding="6"
                                                                Style="{StaticResource SubtleButtonStyle}"
                                                                Tag="{x:Bind ProviderId}">
                                                                <FontIcon
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    FontSize="12"
                                                                    Glyph="&#xE74B;"
                                                                    IsTextScaleFactorEnabled="False" />
                                                                </Button>
                                                                <ToggleButton
                                                                 x:Uid="DashboardProviderVisibilityButton"
                                                                 Grid.Column="4"
                                                                 AutomationProperties.AutomationId="{x:Bind VisibilityAutomationId}"
                                                                 AutomationProperties.Name="{x:Bind VisibilityAutomationName}"
                                                                Click="OnDashboardProviderVisibilityClicked"
                                                                IsChecked="{x:Bind IsVisible, Mode=OneTime}"
                                                                MinHeight="32"
                                                                MinWidth="32"
                                                                Padding="6"
                                                                Tag="{x:Bind ProviderId}">
                                                                <FontIcon
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    FontSize="12"
                                                                    Glyph="&#xE890;"
                                                                    IsTextScaleFactorEnabled="False" />
                                                                </ToggleButton>
                                                                <ToggleButton
                                                                 x:Uid="DashboardProviderHighlightButton"
                                                                 Grid.Column="5"
                                                                 AutomationProperties.AutomationId="{x:Bind HighlightAutomationId}"
                                                                 AutomationProperties.Name="{x:Bind HighlightAutomationName}"
                                                                Click="OnDashboardProviderHighlightClicked"
                                                                IsChecked="{x:Bind IsHighlighted, Mode=OneTime}"
                                                                MinHeight="32"
                                                                MinWidth="32"
                                                                Padding="6"
                                                                Tag="{x:Bind ProviderId}">
                                                                <FontIcon
                                                                    AutomationProperties.AccessibilityView="Raw"
                                                                    FontSize="12"
                                                                    Glyph="&#xE734;"
                                                                    IsTextScaleFactorEnabled="False" />
                                                                </ToggleButton>
                                                                <Button
                                                                    x:Uid="DashboardProviderColorButton"
                                                                    Grid.Column="6"
                                                                    AutomationProperties.AutomationId="{x:Bind ColorAutomationId}"
                                                                    AutomationProperties.Name="{x:Bind ColorAutomationName}"
                                                                    Click="OnDashboardProviderColorClicked"
                                                                    MinHeight="32"
                                                                    MinWidth="32"
                                                                    Padding="6"
                                                                    Style="{StaticResource SubtleButtonStyle}"
                                                                    Tag="{x:Bind Self}">
                                                                    <FontIcon
                                                                        AutomationProperties.AccessibilityView="Raw"
                                                                        FontSize="12"
                                                                        Glyph="&#xE790;"
                                                                        IsTextScaleFactorEnabled="False" />
                                                                    <Button.Flyout>
                                                                        <Flyout Closed="OnDashboardProviderColorFlyoutClosed">
                                                                            <ColorPicker
                                                                                AutomationProperties.AutomationId="{x:Bind ColorPickerAutomationId}"
                                                                                AutomationProperties.Name="{x:Bind ColorAutomationName}"
                                                                                IsAlphaEnabled="False"
                                                                                IsAlphaSliderVisible="False"
                                                                                IsAlphaTextInputVisible="False"
                                                                                IsColorChannelTextInputVisible="False"
                                                                                IsMoreButtonVisible="False"
                                                                                MinWidth="240"
                                                                                Tag="{x:Bind Self}" />
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                            <Expander
                                                                x:Name="ProviderMetricsExpander"
                                                                x:Uid="DashboardProviderMetricsExpander"
                                                                AutomationProperties.AutomationId="{x:Bind MetricsAutomationId}"
                                                                AutomationProperties.Name="{x:Bind MetricsAutomationName}"
                                                                Collapsed="OnDashboardProviderMetricsCollapsed"
                                                                Expanding="OnDashboardProviderMetricsExpanding"
                                                                IsExpanded="{x:Bind IsMetricsExpanded, Mode=OneTime}"
                                                                Margin="20,0,0,0"
                                                                Tag="{x:Bind Self}"
                                                                Visibility="{x:Bind HasMetrics}">
                                                                <ItemsControl
                                                                    x:Name="ProviderMetricsItems"
                                                                    ItemsSource="{x:Bind ExpandedMetrics}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="viewModels:DashboardMetricLayoutRow">
                                                                            <Border
                                                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                                                AutomationProperties.Name="{x:Bind Label}"
                                                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                                                BorderThickness="0,1,0,0"
                                                                                Padding="0,3">
                                                                                <Grid ColumnSpacing="2" MinHeight="36">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="32" />
                                                                                        <ColumnDefinition Width="32" />
                                                                                        <ColumnDefinition Width="32" />
                                                                                        <ColumnDefinition Width="32" />
                                                                                        <ColumnDefinition Width="32" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel VerticalAlignment="Center">
                                                                                        <TextBlock
                                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                                            Text="{x:Bind Label}"
                                                                                            TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock
                                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                            Text="{x:Bind SectionLabel}"
                                                                                            TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <Button
                                                                                        x:Uid="DashboardMetricMoveUpButton"
                                                                                        Grid.Column="1"
                                                                                        AutomationProperties.AutomationId="{x:Bind MoveUpAutomationId}"
                                                                                        AutomationProperties.Name="{x:Bind MoveUpAutomationName}"
                                                                                        Click="OnDashboardMetricMoveUpClicked"
                                                                                        CommandParameter="{x:Bind MetricId}"
                                                                                        IsEnabled="{x:Bind CanMoveUp}"
                                                                                        MinHeight="32"
                                                                                        MinWidth="32"
                                                                                        Padding="6"
                                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                                        Tag="{x:Bind ProviderId}">
                                                                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Glyph="&#xE74A;" IsTextScaleFactorEnabled="False" />
                                                                                    </Button>
                                                                                    <Button
                                                                                        x:Uid="DashboardMetricMoveDownButton"
                                                                                        Grid.Column="2"
                                                                                        AutomationProperties.AutomationId="{x:Bind MoveDownAutomationId}"
                                                                                        AutomationProperties.Name="{x:Bind MoveDownAutomationName}"
                                                                                        Click="OnDashboardMetricMoveDownClicked"
                                                                                        CommandParameter="{x:Bind MetricId}"
                                                                                        IsEnabled="{x:Bind CanMoveDown}"
                                                                                        MinHeight="32"
                                                                                        MinWidth="32"
                                                                                        Padding="6"
                                                                                        Style="{StaticResource SubtleButtonStyle}"
                                                                                        Tag="{x:Bind ProviderId}">
                                                                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Glyph="&#xE74B;" IsTextScaleFactorEnabled="False" />
                                                                                    </Button>
                                                                                    <ToggleButton
                                                                                        x:Uid="DashboardMetricVisibilityButton"
                                                                                        Grid.Column="3"
                                                                                        AutomationProperties.AutomationId="{x:Bind VisibilityAutomationId}"
                                                                                        AutomationProperties.Name="{x:Bind VisibilityAutomationName}"
                                                                                        Click="OnDashboardMetricVisibilityClicked"
                                                                                        CommandParameter="{x:Bind MetricId}"
                                                                                        IsChecked="{x:Bind IsVisible, Mode=OneTime}"
                                                                                        MinHeight="32"
                                                                                        MinWidth="32"
                                                                                        Padding="6"
                                                                                        Tag="{x:Bind ProviderId}">
                                                                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Glyph="&#xE890;" IsTextScaleFactorEnabled="False" />
                                                                                    </ToggleButton>
                                                                                    <ToggleButton
                                                                                        x:Uid="DashboardMetricHighlightButton"
                                                                                        Grid.Column="4"
                                                                                        AutomationProperties.AutomationId="{x:Bind HighlightAutomationId}"
                                                                                        AutomationProperties.Name="{x:Bind HighlightAutomationName}"
                                                                                        Click="OnDashboardMetricHighlightClicked"
                                                                                        CommandParameter="{x:Bind MetricId}"
                                                                                        IsChecked="{x:Bind IsHighlighted, Mode=OneTime}"
                                                                                        MinHeight="32"
                                                                                        MinWidth="32"
                                                                                        Padding="6"
                                                                                        Tag="{x:Bind ProviderId}">
                                                                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Glyph="&#xE734;" IsTextScaleFactorEnabled="False" />
                                                                                    </ToggleButton>
                                                                                    <ToggleButton
                                                                                        x:Uid="DashboardMetricSectionButton"
                                                                                        Grid.Column="5"
                                                                                        AutomationProperties.AutomationId="{x:Bind SectionAutomationId}"
                                                                                        AutomationProperties.Name="{x:Bind SectionAutomationName}"
                                                                                        Click="OnDashboardMetricSectionClicked"
                                                                                        CommandParameter="{x:Bind MetricId}"
                                                                                        IsChecked="{x:Bind IsOnDemand, Mode=OneTime}"
                                                                                        MinHeight="32"
                                                                                        MinWidth="32"
                                                                                        Padding="6"
                                                                                        Tag="{x:Bind ProviderId}">
                                                                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="11" Glyph="&#xE8AB;" IsTextScaleFactorEnabled="False" />
                                                                                    </ToggleButton>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <Border
                                    AutomationProperties.AutomationId="VercelConnectionSection"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="10,8"
                                    Visibility="{x:Bind ViewModel.IsProvidersOptionsSection, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    x:Uid="VercelSectionTitle"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    VerticalAlignment="Center" />
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                                    <TextBlock
                                                        x:Uid="VercelExperimentalBadge"
                                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                            </StackPanel>
                                            <ProgressRing
                                                x:Name="VercelBusyIndicator"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="VercelBusyIndicator"
                                                Height="20"
                                                IsActive="{x:Bind ViewModel.Vercel.IsBusy, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.Vercel.IsBusy, Mode=OneWay}"
                                                Width="20" />
                                        </Grid>
                                        <TextBlock
                                            x:Uid="VercelSectionDescription"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                        <InfoBar
                                            x:Name="VercelRiskInfo"
                                            x:Uid="VercelRiskInfo"
                                            AutomationProperties.AutomationId="VercelRiskInfo"
                                            IsClosable="False"
                                            IsOpen="{x:Bind ViewModel.Vercel.IsConnectFormVisible, Mode=OneWay}"
                                            Severity="Warning" />
                                        <StackPanel
                                            Spacing="8"
                                            Visibility="{x:Bind ViewModel.Vercel.IsConnectFormVisible, Mode=OneWay}">
                                            <PasswordBox
                                                x:Name="VercelApiKeyBox"
                                                x:Uid="VercelApiKeyBox"
                                                AutomationProperties.AutomationId="VercelApiKeyBox"
                                                IsEnabled="{x:Bind ViewModel.Vercel.IsInputEnabled, Mode=OneWay}"
                                                PasswordChanged="OnVercelApiKeyPasswordChanged" />
                                            <TextBox
                                                x:Name="VercelKeyIdBox"
                                                x:Uid="VercelKeyIdBox"
                                                AutomationProperties.AutomationId="VercelKeyIdBox"
                                                IsEnabled="{x:Bind ViewModel.Vercel.IsInputEnabled, Mode=OneWay}"
                                                TextChanged="OnVercelKeyIdTextChanged" />
                                            <TextBlock
                                                x:Uid="VercelKeyIdError"
                                                AutomationProperties.AutomationId="VercelKeyIdError"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{x:Bind ViewModel.Vercel.IsKeyIdErrorVisible, Mode=OneWay}" />
                                            <CheckBox
                                                x:Name="VercelConsentCheckBox"
                                                x:Uid="VercelConsentCheckBox"
                                                AutomationProperties.AutomationId="VercelConsentCheckBox"
                                                IsChecked="{x:Bind ViewModel.Vercel.IsConsentAccepted, Mode=TwoWay}" />
                                            <Button
                                                x:Name="VercelConnectButton"
                                                x:Uid="VercelConnectButton"
                                                AutomationProperties.AutomationId="VercelConnectButton"
                                                Click="OnVercelConnectClicked"
                                                HorizontalAlignment="Left"
                                                IsEnabled="{x:Bind ViewModel.Vercel.CanSubmitConnection, Mode=OneWay}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                        <InfoBar
                                            x:Name="VercelConnectionStatus"
                                            AutomationProperties.AutomationId="VercelConnectionStatus"
                                            AutomationProperties.LiveSetting="Polite"
                                            IsClosable="False"
                                            IsOpen="{x:Bind ViewModel.Vercel.IsStatusOpen, Mode=OneWay}"
                                            Message="{x:Bind ViewModel.Vercel.StatusText, Mode=OneWay}"
                                            Severity="{x:Bind ViewModel.Vercel.State, Mode=OneWay, Converter={StaticResource VercelGatewayStatusSeverityConverter}}" />
                                        <Button
                                            x:Name="VercelDisconnectButton"
                                            x:Uid="VercelDisconnectButton"
                                            AutomationProperties.AutomationId="VercelDisconnectButton"
                                            Command="{x:Bind ViewModel.Vercel.DisconnectCommand}"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Visibility="{x:Bind ViewModel.Vercel.IsDisconnectVisible, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    AutomationProperties.AutomationId="ProviderStatusSection"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Visibility="{x:Bind ViewModel.IsProvidersOptionsSection, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8" RowSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                x:Uid="ProviderStatusSectionTitle"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                x:Uid="ProviderStatusRefreshButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="ProviderStatusRefreshButton"
                                                Command="{x:Bind ViewModel.RefreshCommand}"
                                                Padding="7"
                                                Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="14"
                                                    Glyph="&#xE72C;"
                                                    IsTextScaleFactorEnabled="False" />
                                            </Button>
                                            <TextBlock
                                                x:Uid="ProviderStatusSectionDescription"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>

                                        <ItemsControl
                                            x:Name="ProviderStatusList"
                                            AutomationProperties.AutomationId="ProviderStatusList"
                                            ItemsSource="{x:Bind ViewModel.ProviderStatuses, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sample:ProviderStatusRow">
                                                    <Border
                                                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,8,0,6">
                                                        <StackPanel Spacing="5">
                                                            <Grid ColumnSpacing="7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <controls:ProviderMarkImage
                                                                    Height="16"
                                                                    ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                                                    VerticalAlignment="Center"
                                                                    Width="16" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                    Text="{x:Bind Name, Mode=OneTime}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind RootState, Mode=OneTime}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{x:Bind Capabilities, Mode=OneTime}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="sample:ProviderCapabilityRow">
                                                                        <Grid
                                                                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                                                            ColumnSpacing="8"
                                                                            MinHeight="20">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                                Text="{x:Bind Label, Mode=OneTime}" />
                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                                Text="{x:Bind Value, Mode=OneTime}"
                                                                                TextWrapping="WrapWholeWords" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind RecoveryText, Mode=OneTime}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel
                        x:Name="DashboardStack"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.IsSample, Mode=OneWay}">
                        <Grid Margin="4,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource DashboardHeadingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DashboardHeading, Mode=OneWay}" />
                                <Grid>
                                    <TextBlock
                                        AutomationProperties.AutomationId="CodexDataState"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.LiveDataStateText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLiveDataStateVisible, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="{x:Bind ViewModel.SampleDataStateAutomationId, Mode=OneWay}"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SampleDataStateText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsSampleDataStateVisible, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="SampleRefreshProgressRing"
                                    x:Uid="LoadingProgressRing"
                                    AutomationProperties.AutomationId="SampleRefreshProgressRing"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsSampleRefreshing, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsSampleRefreshing, Mode=OneWay}"
                                    Width="14" />
                                <TextBlock
                                    Style="{StaticResource DashboardAmountTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ActiveSample.TotalSpendAmount, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ActiveSample.HasSpend, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="SampleTotalSpendCard"
                            x:Load="{x:Bind ViewModel.ActiveSample.HasSpend, Mode=OneWay}"
                            AutomationProperties.AutomationId="SampleTotalSpendCard"
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DashboardCardCornerRadius}">
                            <Grid
                                ColumnSpacing="12"
                                Loaded="OnSampleSpendLayoutLoaded">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:SpendDonutChart
                                    x:Name="SampleSpendDonutChart"
                                    AccessibleName="{x:Bind ViewModel.ActiveSample.SpendAccessibleName, Mode=OneWay}"
                                    CenterValue="{x:Bind ViewModel.ActiveSample.DonutCenterAmount, Mode=OneWay}"
                                    Slices="{x:Bind ViewModel.ActiveSample.SpendSlices, Mode=OneWay}" />

                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{x:Bind ViewModel.ActiveSample.SpendSlices, Mode=OneWay}"
                                    VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sample:SampleSpendSlice">
                                            <Grid MinHeight="20" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:ProviderColorSwatch
                                                    ColorHex="{x:Bind ColorHex}"
                                                    Height="12"
                                                    ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                                    VerticalAlignment="Center"
                                                    Width="12" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind ProviderName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind AmountText}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="UsageProductCard"
                            x:Load="{x:Bind ViewModel.IsLocalUsageVisible, Mode=OneWay}"
                            AutomationProperties.AutomationId="UsageProductCard"
                            AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.Title, Mode=OneWay}"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DashboardCardCornerRadius}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock
                                            Style="{StaticResource DashboardHeadingTextBlockStyle}"
                                            Text="{x:Bind ViewModel.LocalUsage.Title, Mode=OneWay}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="UsageProductCard.DataOrigin"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.LocalUsage.SourceLabel, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="UsageProductCard.Period"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.LocalUsage.PeriodLabel, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.LocalUsage.NoticeText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.LocalUsage.OtherPeriods, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sample:LocalUsagePeriodRow">
                                            <Border
                                                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                                MinHeight="40"
                                                Margin="0,0,0,4"
                                                Padding="8,4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <StackPanel Spacing="1">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                            Text="{x:Bind Label, Mode=OneTime}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                            Text="{x:Bind CostText, Mode=OneTime}"
                                                            TextAlignment="Right"
                                                            TextWrapping="WrapWholeWords" />
                                                    </Grid>
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                        Text="{x:Bind DetailText, Mode=OneTime}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.LocalUsage.Metrics, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sample:SampleMetric">
                                            <Grid
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                AutomationProperties.Name="{x:Bind AutomationName}"
                                                MinHeight="20"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind Label}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind Value}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander
                                    AutomationProperties.AutomationId="UsageProductCard.Breakdown30Days"
                                    AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AccessibleName, Mode=OneWay}"
                                    IsExpanded="False"
                                    Visibility="{x:Bind ViewModel.LocalUsage.SpendBreakdown.HasContent, Mode=OneWay}">
                                    <Expander.Header>
                                        <StackPanel Spacing="1">
                                            <TextBlock
                                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.LocalUsage.SpendBreakdown.Title, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.LocalUsage.SpendBreakdown.SummaryText, Mode=OneWay}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Padding="0,6,0,0" Spacing="8">
                                        <Grid
                                            AutomationProperties.AutomationId="UsageProductCard.AgentRing30Days"
                                            AutomationProperties.Name="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AccessibleName, Mode=OneWay}"
                                            ColumnSpacing="10"
                                            Loaded="OnSampleSpendLayoutLoaded"
                                            Visibility="{x:Bind ViewModel.LocalUsage.SpendBreakdown.HasAgentSpend, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SpendDonutChart
                                                AccessibleName="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AccessibleName, Mode=OneWay}"
                                                CenterValue="{x:Bind ViewModel.LocalUsage.SpendBreakdown.DonutCenterText, Mode=OneWay}"
                                                Height="88"
                                                Slices="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AgentSlices, Mode=OneWay}"
                                                Width="88" />
                                            <ItemsControl
                                                Grid.Column="1"
                                                ItemsSource="{x:Bind ViewModel.LocalUsage.SpendBreakdown.AgentSlices, Mode=OneWay}"
                                                VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sample:SampleSpendSlice">
                                                        <Grid MinHeight="32" ColumnSpacing="6" RowSpacing="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <controls:ProviderColorSwatch
                                                                ColorHex="{x:Bind ColorHex, Mode=OneTime}"
                                                                Grid.RowSpan="2"
                                                                Height="12"
                                                                ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                                                VerticalAlignment="Center"
                                                                Width="12" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                Text="{x:Bind ProviderName, Mode=OneTime}"
                                                                TextWrapping="WrapWholeWords" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                Text="{x:Bind AmountText, Mode=OneTime}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <ListView
                                            AutomationProperties.AutomationId="UsageProductCard.ModelBreakdown"
                                            IsItemClickEnabled="False"
                                            ItemsSource="{x:Bind ViewModel.LocalUsage.SpendBreakdown.Models, Mode=OneWay}"
                                            MaxHeight="180"
                                            SelectionMode="None"
                                            Visibility="{x:Bind ViewModel.LocalUsage.SpendBreakdown.HasModels, Mode=OneWay}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="sample:LocalUsageModelRow">
                                                    <Grid
                                                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}"
                                                        MinHeight="40"
                                                        Padding="0,4"
                                                        RowSpacing="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                            Text="{x:Bind Title, Mode=OneTime}"
                                                            TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                            TextWrapping="WrapWholeWords">
                                                            <Run Text="{x:Bind ReportedText, Mode=OneTime}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{x:Bind EstimatedText, Mode=OneTime}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{x:Bind CoverageText, Mode=OneTime}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border
                            AutomationProperties.AutomationId="DashboardAllProvidersHidden"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="10,8"
                            Visibility="{x:Bind ViewModel.AreAllDashboardProvidersHidden, Mode=OneWay}">
                            <TextBlock
                                x:Uid="DashboardAllProvidersHidden"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                TextWrapping="WrapWholeWords" />
                        </Border>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveSample.Providers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sample:SampleProviderCard">
                                    <StackPanel Margin="0,0,0,10" Spacing="6">
                                        <Grid Margin="4,0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:ProviderMarkImage
                                                Height="18"
                                                ProviderId="{x:Bind ProviderId, Mode=OneTime}"
                                                VerticalAlignment="Center"
                                                Width="18" />
                                            <Grid Grid.Column="1" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Style="{StaticResource DashboardCompactStrongTextBlockStyle}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <FontIcon
                                                    Grid.Column="1"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE734;"
                                                    IsTextScaleFactorEnabled="False"
                                                    ToolTipService.ToolTip="{x:Bind HighlightLabel}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind HasHighlight}" />
                                            </Grid>
                                            <Border
                                                Grid.Column="2"
                                                Padding="7,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind PlanLabel}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button
                                                Grid.Column="4"
                                                AutomationProperties.AutomationId="{x:Bind DetailsAutomationId}"
                                                AutomationProperties.HelpText="{x:Bind DetailsTooltip}"
                                                AutomationProperties.Name="{x:Bind DetailsAutomationName}"
                                                MinHeight="32"
                                                MinWidth="32"
                                                Padding="6"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind DetailsTooltip}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasDetails}">
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="14"
                                                    IsTextScaleFactorEnabled="False"
                                                    Glyph="&#xE946;" />
                                                <Button.Flyout>
                                                    <Flyout Placement="Left">
                                                        <StackPanel Spacing="8" Width="220">
                                                            <TextBlock
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind Name}" />
                                                            <StackPanel Spacing="2">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind SourceLabel}" />
                                                                <TextBlock
                                                                    AutomationProperties.AutomationId="{x:Bind DetailsSourceAutomationId}"
                                                                    Text="{x:Bind SourceValue}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind ObservedLabel}" />
                                                                <TextBlock
                                                                    AutomationProperties.AutomationId="{x:Bind DetailsObservedAutomationId}"
                                                                    Text="{x:Bind ObservedValue}"
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <ToggleButton
                                                x:Uid="ProviderSecondaryMetricsToggle"
                                                Grid.Column="3"
                                                AutomationProperties.AutomationId="{x:Bind SecondaryMetricsAutomationId}"
                                                IsChecked="{x:Bind IsOnDemandMetricsExpanded, Mode=TwoWay}"
                                                MinHeight="32"
                                                MinWidth="32"
                                                Padding="6"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasOnDemandMetrics}">
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="14"
                                                    Glyph="&#xE9D2;"
                                                    IsTextScaleFactorEnabled="False" />
                                            </ToggleButton>
                                        </Grid>

                                        <Border
                                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                            AutomationProperties.Name="{x:Bind CardAutomationName}"
                                            Padding="12,10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DashboardCardCornerRadius}">
                                            <StackPanel Spacing="7">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind CapabilityLabel}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                    Text="{x:Bind NoticeText}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind HasNotice}" />

                                                <ItemsControl ItemsSource="{x:Bind PrimaryMetricItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sample:SampleDashboardMetricItem">
                                                            <StackPanel>
                                                                <StackPanel Margin="0,0,0,10" Spacing="3" Visibility="{x:Bind IsQuotaWindow}">
                                                                    <TextBlock Style="{StaticResource DashboardCompactStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                                    <controls:AnimatedProgressBar
                                                                        AutomationName="{x:Bind WindowAutomationName}"
                                                                        Height="5"
                                                                        RemainingValue="{x:Bind ColorRemainingPercent}"
                                                                        TargetValue="{x:Bind RemainingPercent}" />
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind RemainingText}" TextWrapping="WrapWholeWords" />
                                                                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind ResetText}" TextAlignment="Right" TextWrapping="WrapWholeWords" />
                                                                    </Grid>
                                                                    <TextBlock
                                                                        AutomationProperties.AutomationId="{x:Bind PaceAutomationId}"
                                                                        AutomationProperties.Name="{x:Bind PaceAutomationName}"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                        Text="{x:Bind PaceText}"
                                                                        TextWrapping="WrapWholeWords"
                                                                        Visibility="{x:Bind HasPace}" />
                                                                </StackPanel>
                                                                <Grid
                                                                    AutomationProperties.AutomationId="{x:Bind MetricAutomationId}"
                                                                    AutomationProperties.Name="{x:Bind MetricAutomationName}"
                                                                    Margin="0,0,0,4"
                                                                    ColumnSpacing="8"
                                                                    Visibility="{x:Bind IsScalarMetric}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Style="{StaticResource DashboardCaptionTextBlockStyle}" Text="{x:Bind Value}" TextWrapping="WrapWholeWords" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl
                                                    ItemsSource="{x:Bind OnDemandMetricItems}"
                                                    Visibility="{x:Bind IsOnDemandMetricsExpanded, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="sample:SampleDashboardMetricItem">
                                                                <StackPanel>
                                                                <StackPanel Margin="0,0,0,10" Spacing="3" Visibility="{x:Bind IsQuotaWindow}">
                                                                    <TextBlock Style="{StaticResource DashboardCompactStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                                    <controls:AnimatedProgressBar
                                                                        AutomationName="{x:Bind WindowAutomationName}"
                                                                        Height="5"
                                                                        RemainingValue="{x:Bind ColorRemainingPercent}"
                                                                        TargetValue="{x:Bind RemainingPercent}" />
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                            Text="{x:Bind RemainingText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                            Text="{x:Bind ResetText}"
                                                                            TextAlignment="Right"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </Grid>
                                                                    <TextBlock
                                                                        AutomationProperties.AutomationId="{x:Bind PaceAutomationId}"
                                                                        AutomationProperties.Name="{x:Bind PaceAutomationName}"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                        Text="{x:Bind PaceText}"
                                                                        TextWrapping="WrapWholeWords"
                                                                        Visibility="{x:Bind HasPace}" />
                                                                </StackPanel>
                                                                <Grid
                                                                    AutomationProperties.AutomationId="{x:Bind MetricAutomationId}"
                                                                    AutomationProperties.Name="{x:Bind MetricAutomationName}"
                                                                    Margin="0,0,0,4"
                                                                    ColumnSpacing="8"
                                                                    Visibility="{x:Bind IsScalarMetric}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                        Text="{x:Bind Label}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Style="{StaticResource DashboardCaptionTextBlockStyle}"
                                                                        Text="{x:Bind Value}"
                                                                        TextWrapping="WrapWholeWords" />
                                                                </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FooterIdentityColumn" Width="*" />
                    <ColumnDefinition x:Name="FooterStatusColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="FlyoutFooterIdentity"
                    x:Uid="FlyoutFooterIdentity"
                    Grid.Column="0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxWidth="120"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <TextBlock
                    x:Name="FlyoutStatusText"
                    AutomationProperties.AutomationId="FlyoutStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="FooterOptionsButton"
                    x:Uid="FooterOptionsButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="FooterOptionsButton"
                    Command="{x:Bind ViewModel.OpenOptionsCommand}"
                    Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            IsTextScaleFactorEnabled="False"
                            Glyph="&#xE713;" />
                        <TextBlock
                            x:Uid="FooterOptionsLabel"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Page>
