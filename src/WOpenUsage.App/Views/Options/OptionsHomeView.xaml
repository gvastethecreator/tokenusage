<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WOpenUsage.App.Views.Options.OptionsHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WOpenUsage.App.Controls"
    xmlns:converters="using:WOpenUsage.App.Converters"
    xmlns:dashboard="using:WOpenUsage.App.ViewModels.Dashboard"
    xmlns:viewModels="using:WOpenUsage.App.ViewModels"
    mc:Ignorable="d">

    <StackPanel
        AutomationProperties.AutomationId="OptionsSectionNavigation"
        Spacing="6">
        <TextBlock
            x:Uid="OptionsHomeDescription"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Margin="2,0,2,4"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="WrapWholeWords" />
        <Button
            x:Name="OptionsGeneralButton"
            x:Uid="OptionsGeneralButton"
            AutomationProperties.AutomationId="OptionsGeneralButton"
            Command="{x:Bind ViewModel.ShowGeneralCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            MinHeight="56"
            Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE713;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Uid="OptionsGeneralLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="OptionsGeneralDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <FontIcon Grid.Column="2" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE76C;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button
            x:Name="OptionsAppearanceButton"
            x:Uid="OptionsAppearanceButton"
            AutomationProperties.AutomationId="OptionsAppearanceButton"
            Command="{x:Bind ViewModel.ShowAppearanceCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            MinHeight="56"
            Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE790;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Uid="OptionsAppearanceLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="OptionsAppearanceDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <FontIcon Grid.Column="2" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE76C;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button
            x:Name="OptionsPersonalizationButton"
            x:Uid="OptionsPersonalizationButton"
            AutomationProperties.AutomationId="OptionsPersonalizationButton"
            Command="{x:Bind ViewModel.ShowPersonalizationCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            MinHeight="56"
            Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE9D9;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Uid="OptionsPersonalizationLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="OptionsPersonalizationDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <FontIcon Grid.Column="2" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE76C;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button
            x:Name="OptionsProvidersButton"
            x:Uid="OptionsProvidersButton"
            AutomationProperties.AutomationId="OptionsProvidersButton"
            Command="{x:Bind ViewModel.ShowProvidersCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            MinHeight="56"
            Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="16" Glyph="&#xE8B7;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Uid="OptionsProvidersLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="OptionsProvidersDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <FontIcon Grid.Column="2" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE76C;" IsTextScaleFactorEnabled="False" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
