<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>TokenUsage.Platform.Windows.Tests</RootNamespace>
    <AssemblyName>TokenUsage.Platform.Windows.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TokenUsage.Platform.Windows\TokenUsage.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\TokenUsage.Providers\TokenUsage.Providers.csproj" />
    <ProjectReference Include="..\..\src\TokenUsage.Runtime.Windows\TokenUsage.Runtime.Windows.csproj" />
    <ProjectReference Include="..\..\src\TokenUsage.Presentation\TokenUsage.Presentation.csproj" />
    <ProjectReference Include="..\TokenUsage.TestSupport.FakeCodex\TokenUsage.TestSupport.FakeCodex.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="CopyFakeCodex" AfterTargets="Build">
    <ItemGroup>
      <FakeCodexArtifacts Include="..\TokenUsage.TestSupport.FakeCodex\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\codex.*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)FakeCodex" />
    <Copy SourceFiles="@(FakeCodexArtifacts)"
          DestinationFolder="$(OutDir)FakeCodex"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
